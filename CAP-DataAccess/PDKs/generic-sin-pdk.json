{
  "fileFormatVersion": 1,
  "name": "Generic SiN (demo)",
  "description": "Generic silicon-nitride (Si3N4) demo PDK for testing the single-process rule (issue #570). A DISTINCT fabrication process from the 220 nm SOI PDKs (different core material and thickness), so it cannot share a chip with them. Geometry is SiN-typical but generic; S-matrices are idealised placeholders, not foundry data.",
  "foundry": "Generic",
  "version": "1.0.0",
  "defaultWavelengthNm": 1550,
  "process": {
    "name": "SiN 400nm",
    "foundry": "Generic",
    "coreThicknessNm": 400,
    "materials": [
      { "name": "Si3N4", "role": "core" },
      { "name": "SiO2", "role": "cladding" }
    ]
  },
  "components": [
    {
      "name": "SiN 1x2 Splitter",
      "category": "Splitters",
      "nazcaFunction": "sin.splitter_1x2",
      "widthMicrometers": 90,
      "heightMicrometers": 60,
      "nazcaOriginOffsetX": 0,
      "nazcaOriginOffsetY": 30,
      "pins": [
        { "name": "in", "offsetXMicrometers": 0, "offsetYMicrometers": 30, "angleDegrees": 180 },
        { "name": "out1", "offsetXMicrometers": 90, "offsetYMicrometers": 27, "angleDegrees": 0 },
        { "name": "out2", "offsetXMicrometers": 90, "offsetYMicrometers": 33, "angleDegrees": 0 }
      ],
      "sMatrix": {
        "wavelengthNm": 1550,
        "connections": [
          { "fromPin": "in", "toPin": "out1", "magnitude": 0.707, "phaseDegrees": 0 },
          { "fromPin": "in", "toPin": "out2", "magnitude": 0.707, "phaseDegrees": 0 }
        ]
      }
    },
    {
      "name": "SiN Straight Waveguide",
      "category": "Waveguides",
      "nazcaFunction": "sin.straight",
      "widthMicrometers": 50,
      "heightMicrometers": 4,
      "nazcaOriginOffsetX": 0,
      "nazcaOriginOffsetY": 2,
      "pins": [
        { "name": "in", "offsetXMicrometers": 0, "offsetYMicrometers": 2, "angleDegrees": 180 },
        { "name": "out", "offsetXMicrometers": 50, "offsetYMicrometers": 2, "angleDegrees": 0 }
      ],
      "sMatrix": {
        "wavelengthNm": 1550,
        "connections": [
          { "fromPin": "in", "toPin": "out", "magnitude": 0.99, "phaseDegrees": 0 }
        ]
      }
    }
  ]
}
