          "fb24dcb6-f4c2-4507-847e-699cc18bec4e"
        ],
        "GridX": 0,
        "GridY": 0,
        "PhysicalX": 500,
        "PhysicalY": 100,
        "Rotation90CounterClock": 0,
        "ChildComponentIds": [
