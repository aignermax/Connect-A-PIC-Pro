        "PhysicalY": 2500,
        "Rotation90CounterClock": 0,
        "ChildComponentIds": [
          "input_a_b7e24ea187f44bfb9436d8457b7da734",
          "input_b_752062418e4e4281b64e01405fd7a863",
          "combine_552adaff8fd64c12b95923292d227e0c",
