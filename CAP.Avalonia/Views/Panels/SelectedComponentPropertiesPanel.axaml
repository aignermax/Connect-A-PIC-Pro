<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CAP.Avalonia.ViewModels"
             xmlns:editors="using:CAP.Avalonia.ViewModels.Properties.Editors"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             x:Class="CAP.Avalonia.Views.Panels.SelectedComponentPropertiesPanel"
             x:DataType="vm:MainViewModel">

    <StackPanel>
        <TextBlock Text="{loc:Localize Properties.SelectedComponent}" Foreground="LightBlue" Margin="0,0,0,5" FontWeight="SemiBold"/>

        <!-- Empty state -->
        <TextBlock Foreground="Gray" FontSize="10" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="{loc:Localize Properties.EmptyState}"
                   IsVisible="{Binding !RightPanel.HasSelectedComponentEditor}"/>

        <!-- Name / position / size readout. Bound to the canonical canvas selection so the
             group name is correct and the position updates live while the component is dragged. -->
        <StackPanel IsVisible="{Binding RightPanel.HasSelectedComponentEditor}">
            <TextBlock Text="{Binding CanvasInteraction.SelectedComponent.DisplayName, FallbackValue='None'}"
                       Foreground="White" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                        IsVisible="{Binding CanvasInteraction.SelectedComponent.ComponentTypeName, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}">
                <TextBlock Text="{loc:Localize Properties.Type}" Foreground="Gray"/>
                <TextBlock Text="{Binding CanvasInteraction.SelectedComponent.ComponentTypeName}"
                           Foreground="#aaaaaa" FontStyle="Italic"/>
            </StackPanel>

            <TextBlock Text="{loc:Localize Properties.Position}" Foreground="Gray" Margin="0,10,0,3"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="X: " Foreground="Gray"/>
                <TextBlock Text="{Binding CanvasInteraction.SelectedComponent.X, StringFormat={}{0:F1}, FallbackValue='-'}"
                           Foreground="White"/>
                <TextBlock Text=" µm    Y: " Foreground="Gray"/>
                <TextBlock Text="{Binding CanvasInteraction.SelectedComponent.Y, StringFormat={}{0:F1}, FallbackValue='-'}"
                           Foreground="White"/>
                <TextBlock Text=" µm" Foreground="Gray"/>
            </StackPanel>

            <TextBlock Text="{loc:Localize Properties.Dimensions}" Foreground="Gray" Margin="0,8,0,3"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding CanvasInteraction.SelectedComponent.Width, StringFormat={}{0:F0}, FallbackValue='-'}"
                           Foreground="White"/>
                <TextBlock Text=" × " Foreground="Gray"/>
                <TextBlock Text="{Binding CanvasInteraction.SelectedComponent.Height, StringFormat={}{0:F0}, FallbackValue='-'}"
                           Foreground="White"/>
                <TextBlock Text=" µm" Foreground="Gray"/>
            </StackPanel>
        </StackPanel>

        <!-- Editor host: DataTemplates pick the right view per editor VM type.
             Name/position/size are shown by the readout above, so the templates
             only carry component-specific controls. -->
        <ContentControl Content="{Binding RightPanel.SelectedComponentEditor}"
                        Margin="0,4,0,0"
                        IsVisible="{Binding RightPanel.HasSelectedComponentEditor}">
            <ContentControl.Resources>
                <!-- ONA Analyzer: just an "open window" button -->
                <DataTemplate x:Key="OnaAnalyzerTpl" x:DataType="editors:OnaAnalyzerEditorViewModel">
                    <StackPanel>
                        <TextBlock Text="{loc:Localize SelectedProps.OnaDescription}"
                                   Foreground="Gray" FontSize="10" Margin="0,2,0,8" TextWrapping="Wrap"/>
                        <Button Content="{loc:Localize SelectedProps.OpenOnaSweep}"
                                Command="{Binding OpenSweepCommand}"
                                Width="180" HorizontalAlignment="Left" Background="#3d5d5d"/>
                    </StackPanel>
                </DataTemplate>

                <!-- Parametric components: one labeled, unit-aware row per
                     named physical parameter (e.g. MMI insertion loss / splitting ratio).
                     The header makes explicit that edits drive the SIMULATION MODEL
                     only — the GDS layout/geometry is never touched by these values. -->
                <DataTemplate x:Key="ParamsTpl" x:DataType="editors:ParametricParametersEditorViewModel">
                    <StackPanel>
                        <TextBlock Text="{loc:Localize SelectedProps.SimulationParams}"
                                   Foreground="LightBlue" FontSize="11" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <TextBlock Text="{loc:Localize SelectedProps.SimulationParamsHint}"
                                   Foreground="Gray" FontSize="9" TextWrapping="Wrap" Margin="0,1,0,2"/>
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="editors:ParameterRowViewModel">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                            <TextBlock Text="{Binding Label}" Foreground="Gray" FontSize="10"/>
                                            <TextBlock Foreground="Gray" FontSize="10"
                                                       IsVisible="{Binding HasUnit}">
                                                <Run Text=" ["/><Run Text="{Binding Unit}"/><Run Text="]"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*,80">
                                            <Slider Grid.Column="0"
                                                    Minimum="{Binding Min}" Maximum="{Binding Max}"
                                                    Value="{Binding Value, Mode=TwoWay}"/>
                                            <NumericUpDown Grid.Column="1"
                                                           Value="{Binding Value, Mode=TwoWay}"
                                                           Minimum="{Binding Min}" Maximum="{Binding Max}"
                                                           Increment="1" FormatString="F2"
                                                           ShowButtonSpinner="False"
                                                           VerticalAlignment="Center"
                                                           Margin="6,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>

                <!-- Slider-driven components (phase shifter, tunable coupler) -->
                <DataTemplate x:Key="SliderTpl" x:DataType="editors:SliderEditorViewModel">
                    <StackPanel>
                        <TextBlock Text="{Binding SliderLabel}" Foreground="Gray" FontSize="10" Margin="0,4,0,2"/>
                        <Grid ColumnDefinitions="*,80">
                            <Slider Grid.Column="0"
                                    Minimum="{Binding Min}" Maximum="{Binding Max}"
                                    Value="{Binding Value, Mode=TwoWay}"/>
                            <!-- No spinner buttons (#779): in the 80px column Fluent's two
                                 spinners would cover the value entirely. The slider handles
                                 stepping; this stays a validated numeric text input. -->
                            <NumericUpDown Grid.Column="1"
                                           Value="{Binding Value, Mode=TwoWay}"
                                           Minimum="{Binding Min}" Maximum="{Binding Max}"
                                           Increment="1" FormatString="F2"
                                           ShowButtonSpinner="False"
                                           VerticalAlignment="Center"
                                           Margin="6,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </DataTemplate>

                <!-- Light-source components (grating coupler, edge coupler).
                     Wavelength is a curated dropdown of simulation-supported values,
                     not a free numeric field. -->
                <DataTemplate x:Key="LightSourceTpl" x:DataType="editors:LightSourceEditorViewModel">
                    <StackPanel>
                        <!-- Laser on/off (#690): a coupler with its laser off is listen-only,
                             i.e. an output. Shares LaserConfig with the canvas laser icon. -->
                        <TextBlock Text="{loc:Localize SelectedProps.Laser}" Foreground="Gray" FontSize="10" Margin="0,4,0,2"/>
                        <ToggleSwitch IsChecked="{Binding LaserConfig.IsEnabled, Mode=TwoWay}"
                                      OnContent="{loc:Localize SelectedProps.LaserOn}" OffContent="{loc:Localize SelectedProps.LaserOff}"
                                      FontSize="11" Margin="0,0,0,4"/>
                        <TextBlock Text="{loc:Localize SelectedProps.Wavelength}" Foreground="Gray" FontSize="10" Margin="0,4,0,2"/>
                        <ComboBox ItemsSource="{Binding WavelengthOptions}"
                                  SelectedValue="{Binding LaserConfig.WavelengthNm, Mode=TwoWay}"
                                  SelectedValueBinding="{Binding WavelengthNm}"
                                  DisplayMemberBinding="{Binding Label}"
                                  IsEnabled="{Binding LaserConfig.IsEnabled}"
                                  HorizontalAlignment="Stretch" Margin="0,0,0,6"/>
                        <TextBlock Text="{loc:Localize SelectedProps.InputPower}" Foreground="Gray" FontSize="10" Margin="0,0,0,2"/>
                        <Slider Minimum="0" Maximum="1"
                                Value="{Binding LaserConfig.InputPower, Mode=TwoWay}"
                                IsEnabled="{Binding LaserConfig.IsEnabled}"
                                TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                        <TextBlock Foreground="#cccccc" FontSize="10">
                            <Run Text="{loc:Localize SelectedProps.Power}"/>
                            <Run Text="{Binding LaserConfig.InputPower, StringFormat={}{0:F2}}"/>
                        </TextBlock>

                        <!-- Realistic source spectrum (#819): line shape + FWHM linewidth.
                             "Ideal" keeps today's single-wavelength behaviour. -->
                        <TextBlock Text="{loc:Localize SelectedProps.LineShape}" Foreground="Gray" FontSize="10" Margin="0,8,0,2"/>
                        <ComboBox ItemsSource="{Binding LineShapeOptions}"
                                  SelectedValue="{Binding LaserConfig.LineShape, Mode=TwoWay}"
                                  SelectedValueBinding="{Binding Value}"
                                  DisplayMemberBinding="{Binding Label}"
                                  IsEnabled="{Binding LaserConfig.IsEnabled}"
                                  HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
                        <StackPanel IsVisible="{Binding LaserConfig.IsSpectralShape}">
                            <TextBlock Text="{loc:Localize SelectedProps.Linewidth}" Foreground="Gray" FontSize="10" Margin="0,2,0,2"/>
                            <Grid ColumnDefinitions="*,30">
                                <NumericUpDown Grid.Column="0"
                                               Value="{Binding LaserConfig.LinewidthFwhmNm, Mode=TwoWay}"
                                               Minimum="0.1" Maximum="50" Increment="0.5"
                                               FormatString="F1" ShowButtonSpinner="False"
                                               IsEnabled="{Binding LaserConfig.IsEnabled}"/>
                                <TextBlock Grid.Column="1" Text="nm" Foreground="Gray" FontSize="10"
                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>
                            <TextBlock Text="{loc:Localize SelectedProps.LinewidthHint}"
                                       Foreground="Gray" FontSize="9" TextWrapping="Wrap" Margin="0,2,0,2"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,4,0,2">
                            <TextBlock Text="{loc:Localize SelectedProps.Rin}" Foreground="Gray" FontSize="10"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="?" Foreground="#7FB2E5" FontSize="10" FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       ToolTip.Tip="{loc:Localize SelectedProps.RinHint}"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,42">
                            <NumericUpDown Grid.Column="0"
                                           Value="{Binding LaserConfig.RinDbPerHz, Mode=TwoWay}"
                                           Minimum="-200" Maximum="-80" Increment="5"
                                           FormatString="F0" ShowButtonSpinner="False"
                                           IsEnabled="{Binding LaserConfig.IsEnabled}"/>
                            <TextBlock Grid.Column="1" Text="dB/Hz" Foreground="Gray" FontSize="10"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </DataTemplate>

                <!-- Fallback: PDK function only (name/position/size come from the readout above).
                     An explicit hint replaces the previously-empty section so users know the
                     component's S-matrix is fixed rather than suspecting a broken editor. -->
                <DataTemplate x:Key="GenericTpl" x:DataType="editors:GenericComponentEditorViewModel">
                    <StackPanel>
                        <TextBlock Text="{Binding NazcaFunction}" Foreground="#888" FontSize="9" Margin="0,2,0,4"/>
                        <TextBlock Text="{loc:Localize SelectedProps.NoSimulationParams}"
                                   Foreground="Gray" FontSize="9" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    </StackPanel>
                </DataTemplate>
            </ContentControl.Resources>
            <ContentControl.DataTemplates>
                <StaticResource ResourceKey="OnaAnalyzerTpl"/>
                <StaticResource ResourceKey="ParamsTpl"/>
                <StaticResource ResourceKey="SliderTpl"/>
                <StaticResource ResourceKey="LightSourceTpl"/>
                <StaticResource ResourceKey="GenericTpl"/>
            </ContentControl.DataTemplates>
        </ContentControl>
    </StackPanel>

</UserControl>
