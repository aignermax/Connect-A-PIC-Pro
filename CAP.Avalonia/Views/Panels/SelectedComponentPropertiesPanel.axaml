<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CAP.Avalonia.ViewModels"
             xmlns:editors="using:CAP.Avalonia.ViewModels.Properties.Editors"
             xmlns:controls="using:CAP.Avalonia.Controls"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             x:Class="CAP.Avalonia.Views.Panels.SelectedComponentPropertiesPanel"
             x:DataType="vm:MainViewModel">

    <StackPanel>
        <TextBlock Text="{loc:Localize Properties.SelectedComponent}" Foreground="LightBlue" Margin="0,0,0,5" FontWeight="SemiBold"/>

        <!-- Empty state -->
        <TextBlock Foreground="Gray" FontSize="10" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="{loc:Localize Properties.EmptyState}"
                   IsVisible="{Binding !RightPanel.HasSelectedComponentEditor}"/>

        <!-- Name / position / size readout. Bound to the canonical canvas selection so the
             group name is correct and the position updates live while the component is dragged. -->
        <StackPanel IsVisible="{Binding RightPanel.HasSelectedComponentEditor}">
            <TextBlock Text="{Binding CanvasInteraction.SelectedComponent.DisplayName, FallbackValue='None'}"
                       Foreground="White" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                        IsVisible="{Binding CanvasInteraction.SelectedComponent.ComponentTypeName, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}">
                <TextBlock Text="{loc:Localize Properties.Type}" Foreground="Gray"/>
                <TextBlock Text="{Binding CanvasInteraction.SelectedComponent.ComponentTypeName}"
                           Foreground="#aaaaaa" FontStyle="Italic"/>
            </StackPanel>

            <TextBlock Text="{loc:Localize Properties.Position}" Foreground="Gray" Margin="0,10,0,3"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="X: " Foreground="Gray"/>
                <TextBlock Text="{Binding CanvasInteraction.SelectedComponent.X, StringFormat={}{0:F1}, FallbackValue='-'}"
                           Foreground="White"/>
                <TextBlock Text=" µm    Y: " Foreground="Gray"/>
                <TextBlock Text="{Binding CanvasInteraction.SelectedComponent.Y, StringFormat={}{0:F1}, FallbackValue='-'}"
                           Foreground="White"/>
                <TextBlock Text=" µm" Foreground="Gray"/>
            </StackPanel>

            <TextBlock Text="{loc:Localize Properties.Dimensions}" Foreground="Gray" Margin="0,8,0,3"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding CanvasInteraction.SelectedComponent.Width, StringFormat={}{0:F0}, FallbackValue='-'}"
                           Foreground="White"/>
                <TextBlock Text=" × " Foreground="Gray"/>
                <TextBlock Text="{Binding CanvasInteraction.SelectedComponent.Height, StringFormat={}{0:F0}, FallbackValue='-'}"
                           Foreground="White"/>
                <TextBlock Text=" µm" Foreground="Gray"/>
            </StackPanel>

            <!-- Manual light-source mark: imported GDS cells can't be recognized by name —
                 the toggle gives them the laser editor and the simulation-source role. -->
            <ToggleSwitch Content="{loc:Localize Properties.MarkAsLightSource}"
                          IsChecked="{Binding CanvasInteraction.SelectedComponent.IsUserMarkedLightSource, Mode=TwoWay, FallbackValue=False}"
                          IsVisible="{Binding CanvasInteraction.SelectedComponent.ShowLightSourceMarkToggle, FallbackValue=False}"
                          FontSize="11" Margin="0,8,0,0"
                          ToolTip.Tip="{loc:Localize Properties.MarkAsLightSourceTip}"/>
        </StackPanel>

        <!-- Editor host: DataTemplates pick the right view per editor VM type.
             Name/position/size are shown by the readout above, so the templates
             only carry component-specific controls. -->
        <ContentControl Content="{Binding RightPanel.SelectedComponentEditor}"
                        Margin="0,4,0,0"
                        IsVisible="{Binding RightPanel.HasSelectedComponentEditor}">
            <ContentControl.Resources>
                <!-- ONA Analyzer: just an "open window" button -->
                <DataTemplate x:Key="OnaAnalyzerTpl" x:DataType="editors:OnaAnalyzerEditorViewModel">
                    <StackPanel>
                        <TextBlock Text="{loc:Localize SelectedProps.OnaDescription}"
                                   Foreground="Gray" FontSize="10" Margin="0,2,0,8" TextWrapping="Wrap"/>
                        <Button Content="{loc:Localize SelectedProps.OpenOnaSweep}"
                                Command="{Binding OpenSweepCommand}"
                                Width="180" HorizontalAlignment="Left" Background="#3d5d5d"/>
                    </StackPanel>
                </DataTemplate>

                <!-- Parametric components: one labeled, unit-aware row per
                     named physical parameter (e.g. MMI insertion loss / splitting ratio).
                     The header makes explicit that edits drive the SIMULATION MODEL
                     only — the GDS layout/geometry is never touched by these values. -->
                <DataTemplate x:Key="ParamsTpl" x:DataType="editors:ParametricParametersEditorViewModel">
                    <StackPanel>
                        <TextBlock Text="{loc:Localize SelectedProps.SimulationParams}"
                                   Foreground="LightBlue" FontSize="11" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <TextBlock Text="{loc:Localize SelectedProps.SimulationParamsHint}"
                                   Foreground="Gray" FontSize="9" TextWrapping="Wrap" Margin="0,1,0,2"/>
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="editors:ParameterRowViewModel">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                            <TextBlock Text="{Binding Label}" Foreground="Gray" FontSize="10"/>
                                            <TextBlock Foreground="Gray" FontSize="10"
                                                       IsVisible="{Binding HasUnit}">
                                                <Run Text=" ["/><Run Text="{Binding Unit}"/><Run Text="]"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*,80">
                                            <Slider Grid.Column="0"
                                                    Minimum="{Binding Min}" Maximum="{Binding Max}"
                                                    Value="{Binding Value, Mode=TwoWay}"/>
                                            <NumericUpDown Grid.Column="1"
                                                           Value="{Binding Value, Mode=TwoWay}"
                                                           Minimum="{Binding Min}" Maximum="{Binding Max}"
                                                           Increment="1" FormatString="F2"
                                                           ShowButtonSpinner="False"
                                                           VerticalAlignment="Center"
                                                           Margin="6,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>

                <!-- Slider-driven components (phase shifter, tunable coupler) -->
                <DataTemplate x:Key="SliderTpl" x:DataType="editors:SliderEditorViewModel">
                    <StackPanel>
                        <TextBlock Text="{Binding SliderLabel}" Foreground="Gray" FontSize="10" Margin="0,4,0,2"/>
                        <Grid ColumnDefinitions="*,80">
                            <Slider Grid.Column="0"
                                    Minimum="{Binding Min}" Maximum="{Binding Max}"
                                    Value="{Binding Value, Mode=TwoWay}"/>
                            <!-- No spinner buttons (#779): in the 80px column Fluent's two
                                 spinners would cover the value entirely. The slider handles
                                 stepping; this stays a validated numeric text input. -->
                            <NumericUpDown Grid.Column="1"
                                           Value="{Binding Value, Mode=TwoWay}"
                                           Minimum="{Binding Min}" Maximum="{Binding Max}"
                                           Increment="1" FormatString="F2"
                                           ShowButtonSpinner="False"
                                           VerticalAlignment="Center"
                                           Margin="6,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </DataTemplate>

                <!-- Light-source components (grating coupler, edge coupler).
                     Wavelength is a curated dropdown of simulation-supported values,
                     not a free numeric field. -->
                <DataTemplate x:Key="LightSourceTpl" x:DataType="editors:LightSourceEditorViewModel">
                    <StackPanel>
                        <!-- Laser on/off (#690): a coupler with its laser off is listen-only,
                             i.e. an output. Shares LaserConfig with the canvas laser icon. -->
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,2">
                            <TextBlock Text="{loc:Localize SelectedProps.Laser}" Foreground="Gray" FontSize="10"
                                       VerticalAlignment="Center"/>
                            <!-- Plain-language help (#907): what wavelength/power mean, why the
                                 source is single-wavelength CW, and what the canvas colors show. -->
                            <controls:HelpFlyoutButton Title="{loc:Localize LaserHelp.Title}"
                                                       VerticalAlignment="Center">
                                <controls:HelpFlyoutButton.HelpContent>
                                    <StackPanel Spacing="8" MaxWidth="400">
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#cfe0ff"
                                                   Text="{loc:Localize LaserHelp.Intro}"/>

                                        <!-- Diagram: laser icon on vs. off, plus the power-flow color ramp. -->
                                        <Border Background="#151515" BorderBrush="#3d3d3d" BorderThickness="1"
                                                CornerRadius="4" Padding="4">
                                            <Canvas Width="360" Height="86">
                                                <!-- Laser on: colored dot with rays. -->
                                                <Ellipse Canvas.Left="20" Canvas.Top="10" Width="18" Height="18" Fill="#FF5252"/>
                                                <Line StartPoint="29,5" EndPoint="29,0" Stroke="#FF5252" StrokeThickness="1.5"/>
                                                <Line StartPoint="16,19" EndPoint="11,19" Stroke="#FF5252" StrokeThickness="1.5"/>
                                                <Line StartPoint="42,19" EndPoint="47,19" Stroke="#FF5252" StrokeThickness="1.5"/>
                                                <Line StartPoint="20,10" EndPoint="16,6" Stroke="#FF5252" StrokeThickness="1.5"/>
                                                <Line StartPoint="38,10" EndPoint="42,6" Stroke="#FF5252" StrokeThickness="1.5"/>
                                                <TextBlock Canvas.Left="4" Canvas.Top="34"
                                                           Text="{loc:Localize LaserHelp.DiagramOn}" FontSize="9" Foreground="Gray"/>
                                                <!-- Laser off: gray dot with a slash. -->
                                                <Ellipse Canvas.Left="100" Canvas.Top="10" Width="18" Height="18" Fill="#9E9E9E"/>
                                                <Line StartPoint="102,26" EndPoint="116,12" Stroke="#DCDCDC" StrokeThickness="1.5"/>
                                                <TextBlock Canvas.Left="84" Canvas.Top="34"
                                                           Text="{loc:Localize LaserHelp.DiagramOff}" FontSize="9" Foreground="Gray"/>
                                                <!-- Power ramp: teal -> green -> yellow -> red. -->
                                                <TextBlock Canvas.Left="170" Canvas.Top="4"
                                                           Text="{loc:Localize LaserHelp.DiagramRamp}" FontSize="9" Foreground="Gray"/>
                                                <Rectangle Canvas.Left="170" Canvas.Top="22" Width="180" Height="10" RadiusX="2" RadiusY="2">
                                                    <Rectangle.Fill>
                                                        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                                            <GradientStop Offset="0" Color="#00B4B4"/>
                                                            <GradientStop Offset="0.33" Color="#32DC32"/>
                                                            <GradientStop Offset="0.66" Color="#FFDC00"/>
                                                            <GradientStop Offset="1" Color="#FF6450"/>
                                                        </LinearGradientBrush>
                                                    </Rectangle.Fill>
                                                </Rectangle>
                                                <TextBlock Canvas.Left="170" Canvas.Top="38"
                                                           Text="{loc:Localize LaserHelp.DiagramWeak}" FontSize="9" Foreground="Gray"/>
                                                <TextBlock Canvas.Left="318" Canvas.Top="38"
                                                           Text="{loc:Localize LaserHelp.DiagramStrong}" FontSize="9" Foreground="Gray"/>
                                                <TextBlock Canvas.Left="170" Canvas.Top="58" Width="180" TextWrapping="Wrap"
                                                           Text="{loc:Localize LaserHelp.DiagramRampNote}" FontSize="9" Foreground="#888888"/>
                                            </Canvas>
                                        </Border>

                                        <TextBlock Text="{loc:Localize LaserHelp.WavelengthPowerTitle}" FontWeight="Bold" FontSize="12" Foreground="White"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="LightGray"
                                                   Text="{loc:Localize LaserHelp.WavelengthPowerBody}"/>

                                        <TextBlock Text="{loc:Localize LaserHelp.CwTitle}" FontWeight="Bold" FontSize="12" Foreground="White" Margin="0,4,0,0"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="LightGray"
                                                   Text="{loc:Localize LaserHelp.CwBody}"/>

                                        <TextBlock Text="{loc:Localize LaserHelp.CanvasTitle}" FontWeight="Bold" FontSize="12" Foreground="White" Margin="0,4,0,0"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="LightGray"
                                                   Text="{loc:Localize LaserHelp.CanvasBody}"/>
                                    </StackPanel>
                                </controls:HelpFlyoutButton.HelpContent>
                            </controls:HelpFlyoutButton>
                        </StackPanel>
                        <ToggleSwitch IsChecked="{Binding LaserConfig.IsEnabled, Mode=TwoWay}"
                                      OnContent="{loc:Localize SelectedProps.LaserOn}" OffContent="{loc:Localize SelectedProps.LaserOff}"
                                      FontSize="11" Margin="0,0,0,4"/>
                        <TextBlock Text="{loc:Localize SelectedProps.Wavelength}" Foreground="Gray" FontSize="10" Margin="0,4,0,2"/>
                        <ComboBox ItemsSource="{Binding WavelengthOptions}"
                                  SelectedValue="{Binding LaserConfig.WavelengthNm, Mode=TwoWay}"
                                  SelectedValueBinding="{Binding WavelengthNm}"
                                  DisplayMemberBinding="{Binding Label}"
                                  IsEnabled="{Binding LaserConfig.IsEnabled}"
                                  HorizontalAlignment="Stretch" Margin="0,0,0,6"/>
                        <TextBlock Text="{loc:Localize SelectedProps.InputPower}" Foreground="Gray" FontSize="10" Margin="0,0,0,2"/>
                        <Slider Minimum="0" Maximum="1"
                                Value="{Binding LaserConfig.InputPower, Mode=TwoWay}"
                                IsEnabled="{Binding LaserConfig.IsEnabled}"
                                TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                        <TextBlock Foreground="#cccccc" FontSize="10">
                            <Run Text="{loc:Localize SelectedProps.Power}"/>
                            <Run Text="{Binding LaserConfig.InputPower, StringFormat={}{0:F2}}"/>
                        </TextBlock>

                        <!-- Realistic source spectrum (#819): line shape + FWHM linewidth.
                             "Ideal" keeps today's single-wavelength behaviour. -->
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,8,0,2">
                            <TextBlock Text="{loc:Localize SelectedProps.LineShape}" Foreground="Gray" FontSize="10"
                                       VerticalAlignment="Center"/>
                            <Button Content="?" Padding="6,1" FontSize="10" FontWeight="Bold"
                                    Background="Transparent" Foreground="#7FB2E5" BorderThickness="0"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="{loc:Localize SelectedProps.LineShapeHint}">
                                <Button.Flyout>
                                    <Flyout>
                                        <StackPanel MaxWidth="360" Spacing="6">
                                            <TextBlock Text="{loc:Localize SelectedProps.LineShapeHint}"
                                                       TextWrapping="Wrap" Foreground="#DDDDDD" FontSize="11"/>
                                            <StackPanel Orientation="Horizontal" Spacing="14">
                                                <StackPanel Spacing="2">
                                                    <Canvas Width="110" Height="34" Background="#252526">
                                                        <Polyline Points="0,32 52.9,32 55,4 57.1,32 110,32"
                                                                  Stroke="#9CDCFE" StrokeThickness="1.5"/>
                                                    </Canvas>
                                                    <TextBlock Text="{loc:Localize SelectedProps.LineShapeIdeal}" Foreground="Gray" FontSize="9" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Spacing="2">
                                                    <Canvas Width="110" Height="34" Background="#252526">
                                                        <Polyline Points="0.0,26.4 2.8,25.9 5.5,25.4 8.3,24.8 11.0,24.1 13.8,23.4 16.5,22.5 19.2,21.6 22.0,20.5 24.7,19.3 27.5,18.0 30.3,16.5 33.0,14.9 35.8,13.2 38.5,11.4 41.2,9.6 44.0,7.9 46.8,6.3 49.5,5.1 52.2,4.3 55.0,4.0 57.8,4.3 60.5,5.1 63.2,6.3 66.0,7.9 68.8,9.6 71.5,11.4 74.2,13.2 77.0,14.9 79.8,16.5 82.5,18.0 85.2,19.3 88.0,20.5 90.8,21.6 93.5,22.5 96.2,23.4 99.0,24.1 101.8,24.8 104.5,25.4 107.2,25.9 110.0,26.4"
                                                                  Stroke="#9CDCFE" StrokeThickness="1.5"/>
                                                    </Canvas>
                                                    <TextBlock Text="{loc:Localize SelectedProps.LineShapeLorentzian}" Foreground="Gray" FontSize="9" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Spacing="2">
                                                    <Canvas Width="110" Height="34" Background="#252526">
                                                        <Polyline Points="0.0,32.0 2.8,32.0 5.5,32.0 8.3,32.0 11.0,32.0 13.8,31.9 16.5,31.9 19.2,31.7 22.0,31.5 24.7,31.0 27.5,30.2 30.3,29.0 33.0,27.3 35.8,24.8 38.5,21.7 41.2,18.0 44.0,14.0 46.8,10.2 49.5,6.9 52.2,4.8 55.0,4.0 57.8,4.8 60.5,6.9 63.2,10.2 66.0,14.0 68.8,18.0 71.5,21.7 74.2,24.8 77.0,27.3 79.8,29.0 82.5,30.2 85.2,31.0 88.0,31.5 90.8,31.7 93.5,31.9 96.2,31.9 99.0,32.0 101.8,32.0 104.5,32.0 107.2,32.0 110.0,32.0"
                                                                  Stroke="#9CDCFE" StrokeThickness="1.5"/>
                                                    </Canvas>
                                                    <TextBlock Text="{loc:Localize SelectedProps.LineShapeGaussian}" Foreground="Gray" FontSize="9" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding LineShapeOptions}"
                                  SelectedValue="{Binding LaserConfig.LineShape, Mode=TwoWay}"
                                  SelectedValueBinding="{Binding Value}"
                                  DisplayMemberBinding="{Binding Label}"
                                  IsEnabled="{Binding LaserConfig.IsEnabled}"
                                  HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
                        <StackPanel IsVisible="{Binding LaserConfig.IsSpectralShape}">
                            <TextBlock Text="{loc:Localize SelectedProps.Linewidth}" Foreground="Gray" FontSize="10" Margin="0,2,0,2"/>
                            <Grid ColumnDefinitions="*,30">
                                <NumericUpDown Grid.Column="0"
                                               Value="{Binding LaserConfig.LinewidthFwhmNm, Mode=TwoWay}"
                                               Minimum="0.1" Maximum="50" Increment="0.5"
                                               FormatString="F1" ShowButtonSpinner="False"
                                               IsEnabled="{Binding LaserConfig.IsEnabled}"/>
                                <TextBlock Grid.Column="1" Text="nm" Foreground="Gray" FontSize="10"
                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>
                            <TextBlock Text="{loc:Localize SelectedProps.LinewidthHint}"
                                       Foreground="Gray" FontSize="9" TextWrapping="Wrap" Margin="0,2,0,2"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,4,0,2">
                            <TextBlock Text="{loc:Localize SelectedProps.Rin}" Foreground="Gray" FontSize="10"
                                       VerticalAlignment="Center"/>
                            <Button Content="?" Padding="6,1" FontSize="10" FontWeight="Bold"
                                    Background="Transparent" Foreground="#7FB2E5" BorderThickness="0"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="{loc:Localize SelectedProps.RinHint}">
                                <Button.Flyout>
                                    <Flyout>
                                        <TextBlock Text="{loc:Localize SelectedProps.RinHint}"
                                                   MaxWidth="340" TextWrapping="Wrap"
                                                   Foreground="#DDDDDD" FontSize="11"/>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <Slider Minimum="-200" Maximum="-80"
                                Value="{Binding LaserConfig.RinDbPerHz, Mode=TwoWay}"
                                IsEnabled="{Binding LaserConfig.IsEnabled}"
                                TickFrequency="5" IsSnapToTickEnabled="True"/>
                        <TextBlock Foreground="#cccccc" FontSize="10">
                            <Run Text="{Binding LaserConfig.RinDbPerHz, StringFormat={}{0:F0}}"/>
                            <Run Text="dB/Hz"/>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>

                <!-- Fallback: PDK function only (name/position/size come from the readout above).
                     An explicit hint replaces the previously-empty section so users know the
                     component's S-matrix is fixed rather than suspecting a broken editor. -->
                <DataTemplate x:Key="GenericTpl" x:DataType="editors:GenericComponentEditorViewModel">
                    <StackPanel>
                        <TextBlock Text="{Binding NazcaFunction}" Foreground="#888" FontSize="9" Margin="0,2,0,4"/>
                        <TextBlock Text="{loc:Localize SelectedProps.NoSimulationParams}"
                                   Foreground="Gray" FontSize="9" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    </StackPanel>
                </DataTemplate>
            </ContentControl.Resources>
            <ContentControl.DataTemplates>
                <StaticResource ResourceKey="OnaAnalyzerTpl"/>
                <StaticResource ResourceKey="ParamsTpl"/>
                <StaticResource ResourceKey="SliderTpl"/>
                <StaticResource ResourceKey="LightSourceTpl"/>
                <StaticResource ResourceKey="GenericTpl"/>
            </ContentControl.DataTemplates>
        </ContentControl>
    </StackPanel>

</UserControl>
