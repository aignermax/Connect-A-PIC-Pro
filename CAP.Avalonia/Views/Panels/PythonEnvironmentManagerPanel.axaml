<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CAP.Avalonia.ViewModels.Export.PythonEnvironmentManager"
             x:Class="CAP.Avalonia.Views.Panels.PythonEnvironmentManagerPanel"
             x:DataType="vm:PythonEnvironmentManagerViewModel">

    <StackPanel>
        <TextBlock Text="Python Environments:" Foreground="LightSkyBlue"
                   Margin="0,0,0,5" FontWeight="SemiBold"/>
        <TextBlock Foreground="Gray" FontSize="10" Margin="0,0,0,8" TextWrapping="Wrap">
            One place to pick the interpreter used for GDS export and preview. Create a managed
            environment (Nazca + gdsfactory pre-installed) or activate one of your system Pythons.
        </TextBlock>

        <!-- Create new managed environment (installs Nazca + gdsfactory together, #645) -->
        <TextBlock Text="Create managed environment:" Foreground="Gray" FontSize="10"
                   Margin="0,0,0,4"/>
        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
            <TextBlock Text="Name:" Foreground="Gray" FontSize="11"
                       VerticalAlignment="Center" Width="50"/>
            <TextBox Text="{Binding NewEnvironmentName}"
                     Width="150" FontSize="11" Watermark="e.g. nazca-env"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
            <TextBlock Text="Python:" Foreground="Gray" FontSize="11"
                       VerticalAlignment="Center" Width="50"/>
            <ComboBox ItemsSource="{Binding PythonVersionChoices}"
                      SelectedItem="{Binding PythonVersion}"
                      Width="90" FontSize="11"/>
        </StackPanel>
        <Button Content="Create + Install (Nazca + gdsfactory)"
                Command="{Binding CreateAndInstallCommand}"
                Background="#3d5d7d" FontSize="11" Margin="0,0,0,6"
                ToolTip.Tip="Creates a managed venv and installs Nazca, pyclipper, gdsfactory and ubcpdk"
                IsEnabled="{Binding IsBusy,
                                    Converter={x:Static BoolConverters.Not}}"/>

        <!-- Progress and cancel -->
        <StackPanel IsVisible="{Binding IsBusy}" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding ProgressText}"
                           Foreground="LightSkyBlue" FontSize="10" TextWrapping="Wrap"/>
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        FontSize="10" Padding="6,2" Background="#5d3d3d"
                        IsEnabled="{Binding CanCancel}"/>
            </StackPanel>
        </StackPanel>

        <!-- Unified interpreter list: managed environments (with health + remove) and
             discovered system Pythons, each activatable the same way (issue #645). -->
        <Separator Margin="0,6,0,6" Background="#2d2d2d"/>
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
            <TextBlock Grid.Column="0" Text="Available interpreters (managed + system):"
                       Foreground="Gray" FontSize="10" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="↻ Rescan" Padding="10,3" FontSize="11"
                    Command="{Binding RefreshInterpretersCommand}"
                    ToolTip.Tip="Search the system again for Python interpreters (shows Nazca + gdsfactory versions)"
                    IsEnabled="{Binding IsDiscoveringInterpreters,
                                        Converter={x:Static BoolConverters.Not}}"/>
        </Grid>

        <!-- Prominent scanning indicator: discovery shells out to every candidate Python and
             can take several seconds, so show an animated bar + explanation (issue #645). -->
        <Border IsVisible="{Binding IsDiscoveringInterpreters}"
                Background="#20303d" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
            <StackPanel Spacing="5">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="🔍" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="Searching your system for Python interpreters…"
                               Foreground="LightSkyBlue" FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Probing each interpreter for Nazca and gdsfactory — this can take a few seconds."
                           Foreground="Gray" FontSize="10" TextWrapping="Wrap"/>
                <ProgressBar IsIndeterminate="True" Height="4" Foreground="LightSkyBlue"/>
            </StackPanel>
        </Border>

        <TextBlock Text="No interpreters found. Create a managed environment above."
                   Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"
                   IsVisible="{Binding ShowNoInterpretersHint}"/>

        <ScrollViewer MaxHeight="260" Margin="0,0,0,6"
                      VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding Interpreters.Count}">
            <ItemsControl ItemsSource="{Binding Interpreters}" x:Name="InterpretersList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1e1e1e" BorderBrush="#3d3d3d" BorderThickness="1"
                                CornerRadius="3" Margin="0,2,0,0" Padding="6,4">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" VerticalAlignment="Center">
                                <!-- Interpreter info (not clickable — activation is an explicit button) -->
                                <StackPanel Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border CornerRadius="3" Padding="4,1" Background="#333333"
                                                IsVisible="{Binding HasStatusBadge}">
                                            <TextBlock Text="{Binding StatusBadge}"
                                                       Foreground="{Binding StatusColor}" FontSize="10"/>
                                        </Border>
                                        <TextBlock Text="{Binding DisplayText}" Foreground="LightGray"
                                                   FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Path}" Foreground="Gray" FontSize="10"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Currently active: static indicator -->
                                <Border Grid.Column="1" IsVisible="{Binding IsActive}"
                                        VerticalAlignment="Center" Margin="2,0,0,0"
                                        CornerRadius="3" Padding="8,3" Background="#2e4d2e">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="✓" Foreground="Gold" FontWeight="Bold" FontSize="11"/>
                                        <TextBlock Text="Active" Foreground="#a8e0a8" FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <!-- Not active: explicit button to switch the active interpreter -->
                                <Button Grid.Column="1" Content="Set Active"
                                        IsVisible="{Binding !IsActive}"
                                        Command="{Binding #InterpretersList.DataContext.SetActiveInterpreterCommand}"
                                        CommandParameter="{Binding}"
                                        VerticalAlignment="Center" Margin="2,0,0,0"
                                        Padding="10,3" FontSize="11" Background="#3d5d3d"
                                        ToolTip.Tip="Switch export and preview to use this interpreter"/>

                                <!-- Managed-only: health check -->
                                <Button Grid.Column="2" Content="Check"
                                        Command="{Binding #InterpretersList.DataContext.CheckHealthInterpreterCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding IsManaged}"
                                        VerticalAlignment="Center" Margin="4,0,0,0"
                                        Padding="8,3" FontSize="10" Background="#3d4d5d"
                                        ToolTip.Tip="Re-check this environment's health"/>

                                <!-- Managed-only: remove -->
                                <Button Grid.Column="3" Content="✕"
                                        Command="{Binding #InterpretersList.DataContext.RemoveInterpreterCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding IsManaged}"
                                        VerticalAlignment="Center" Margin="4,0,0,0"
                                        Padding="8,3" FontSize="10" Background="#5d3d3d"
                                        ToolTip.Tip="Remove this managed environment (deletes its venv)"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Status (idle) -->
        <TextBlock Text="{Binding ProgressText}"
                   Foreground="Gray" FontSize="10" TextWrapping="Wrap"
                   IsVisible="{Binding IsBusy,
                                       Converter={x:Static BoolConverters.Not}}"
                   Margin="0,0,0,4"/>
    </StackPanel>

</UserControl>
