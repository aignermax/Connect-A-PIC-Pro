<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CAP.Avalonia.ViewModels"
             xmlns:controls="using:CAP.Avalonia.Controls"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             xmlns:logic="using:CAP.Avalonia.ViewModels.Analysis.LogicAnalysis"
             x:Class="CAP.Avalonia.Views.Panels.LogicPanel"
             x:DataType="vm:MainViewModel">

    <StackPanel>
        <Separator Margin="0,20,0,10" Background="#3d3d3d"/>
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:Localize LogicPanel.Title}" Foreground="MediumPurple" Margin="0,0,0,5" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <!-- Plain-language help: why the logic layer restores clean 0/1 levels
                 while the passive optical cascade gives up after about two stages. -->
            <controls:HelpFlyoutButton Grid.Column="1"
                                       Title="{loc:Localize LogicPanelHelp.Title}"
                                       VerticalAlignment="Center" Margin="0,-5,0,0">
                <controls:HelpFlyoutButton.HelpContent>
                    <StackPanel Spacing="8" MaxWidth="400">
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#cfe0ff"
                                   Text="{loc:Localize LogicPanelHelp.Intro}"/>

                        <TextBlock Text="{loc:Localize LogicPanelHelp.RestorationTitle}" FontWeight="Bold" FontSize="12" Foreground="White"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="LightGray"
                                   Text="{loc:Localize LogicPanelHelp.RestorationBody}"/>

                        <TextBlock Text="{loc:Localize LogicPanelHelp.InputsTitle}" FontWeight="Bold" FontSize="12" Foreground="White" Margin="0,4,0,0"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="LightGray"
                                   Text="{loc:Localize LogicPanelHelp.InputsBody}"/>
                    </StackPanel>
                </controls:HelpFlyoutButton.HelpContent>
            </controls:HelpFlyoutButton>
        </Grid>

        <TextBlock Text="{loc:Localize LogicPanel.Hint}" Foreground="Gray" FontSize="10" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,5">
            <Button Content="{loc:Localize LogicPanel.Build}"
                    Command="{Binding RightPanel.Logic.BuildNetworkCommand}"
                    Width="150" Padding="8,4" Background="#3d5d3d"
                    IsEnabled="{Binding RightPanel.Logic.IsProcessing, Converter={x:Static BoolConverters.Not}}"/>
            <Button Content="{loc:Localize Common.Cancel}"
                    Command="{Binding RightPanel.Logic.CancelCommand}"
                    Width="70" Padding="8,4" Margin="5,0,0,0" Background="#5d3d3d"
                    IsVisible="{Binding RightPanel.Logic.IsProcessing}"/>
        </StackPanel>
        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,5"
                     IsVisible="{Binding RightPanel.Logic.IsProcessing}"/>
        <TextBlock Text="{Binding RightPanel.Logic.WavelengthText}" Foreground="Gray" FontSize="10" Margin="0,0,0,5"
                   IsVisible="{Binding RightPanel.Logic.WavelengthText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        <TextBlock Text="{Binding RightPanel.Logic.StatusText}" Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,5"
                   IsVisible="{Binding RightPanel.Logic.StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

        <!-- Optical fan-out warnings (#996): non-blocking, the idealized logic result
             stays available — the warning marks where a physical implementation would
             need splitters and level restoration. -->
        <Border IsVisible="{Binding RightPanel.Logic.HasFanOutWarnings}"
                Background="#2a2413" BorderBrush="#8a6d1f" BorderThickness="1"
                CornerRadius="4" Padding="6" Margin="0,0,0,5">
            <StackPanel Spacing="3">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{loc:Localize LogicPanel.FanOutWarning.Title}"
                               Foreground="#e6c860" FontSize="10" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <!-- Education piece: why the half-/full-adder examples duplicate
                         their XOR ladders instead of splitting one output. -->
                    <controls:HelpFlyoutButton Grid.Column="1"
                                               Title="{loc:Localize LogicPanelFanOutHelp.Title}"
                                               VerticalAlignment="Center" Margin="4,-4,0,0">
                        <controls:HelpFlyoutButton.HelpContent>
                            <StackPanel Spacing="8" MaxWidth="400">
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#cfe0ff"
                                           Text="{loc:Localize LogicPanelFanOutHelp.Intro}"/>

                                <TextBlock Text="{loc:Localize LogicPanelFanOutHelp.PhysicsTitle}" FontWeight="Bold" FontSize="12" Foreground="White"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="LightGray"
                                           Text="{loc:Localize LogicPanelFanOutHelp.PhysicsBody}"/>

                                <TextBlock Text="{loc:Localize LogicPanelFanOutHelp.ExamplesTitle}" FontWeight="Bold" FontSize="12" Foreground="White" Margin="0,4,0,0"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="LightGray"
                                           Text="{loc:Localize LogicPanelFanOutHelp.ExamplesBody}"/>
                            </StackPanel>
                        </controls:HelpFlyoutButton.HelpContent>
                    </controls:HelpFlyoutButton>
                </Grid>
                <ItemsControl ItemsSource="{Binding RightPanel.Logic.FanOutWarnings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="logic:LogicFanOutWarningViewModel">
                            <StackPanel Spacing="1">
                                <TextBlock Text="{Binding WarningText}" Foreground="#e6c860"
                                           FontSize="10" TextWrapping="Wrap"/>
                                <!-- Quantitative level report (#1011): the ideal-split arithmetic
                                     and one verdict per receiving input. -->
                                <TextBlock Text="{Binding SplitLine}" Foreground="#d8b44a"
                                           FontSize="10" TextWrapping="Wrap"/>
                                <ItemsControl ItemsSource="{Binding VerdictLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{Binding}" Foreground="#d8b44a"
                                                       FontSize="10" TextWrapping="Wrap" Margin="10,0,0,0"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{loc:Localize LogicPanel.FanOutWarning.PhysicsNote}"
                           Foreground="#a89040" FontSize="10" TextWrapping="Wrap" FontStyle="Italic"/>
            </StackPanel>
        </Border>

        <!-- The assembled network: one toggle per unconnected gate input, one live
             0/1 indicator per gate output -->
        <StackPanel IsVisible="{Binding RightPanel.Logic.HasNetwork}">
            <TextBlock Text="{loc:Localize LogicPanel.Inputs}" Foreground="Gray" FontSize="10" Margin="0,5,0,2"/>
            <ItemsControl ItemsSource="{Binding RightPanel.Logic.Inputs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="logic:LogicNetworkInputViewModel">
                        <CheckBox Content="{Binding PinName}" IsChecked="{Binding IsOn}"
                                  Foreground="LightGray" FontSize="11" Margin="0,1"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{loc:Localize LogicPanel.Outputs}" Foreground="Gray" FontSize="10" Margin="0,8,0,2"/>
            <ItemsControl ItemsSource="{Binding RightPanel.Logic.Outputs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="logic:LogicNetworkOutputViewModel">
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <TextBlock Text="{Binding PinName}" Foreground="LightGray" FontSize="11" Width="110" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding BitText}" FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                       Foreground="LightGreen" IsVisible="{Binding IsOne}"/>
                            <TextBlock Text="{Binding BitText}" FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                       Foreground="Gray" IsVisible="{Binding IsOne, Converter={x:Static BoolConverters.Not}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>

</UserControl>
