<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="using:CAP.Avalonia.ViewModels.Settings"
        xmlns:vmCanvas="using:CAP.Avalonia.ViewModels.Canvas"
        xmlns:vmUpdate="using:CAP.Avalonia.ViewModels.Update"
        xmlns:vmExport="using:CAP.Avalonia.ViewModels.Export"
        xmlns:vmAi="using:CAP.Avalonia.ViewModels.AI"
        xmlns:vmPyEnv="using:CAP.Avalonia.ViewModels.Export.PythonEnvironmentManager"
        xmlns:panels="using:CAP.Avalonia.Views.Panels"
        xmlns:loc="using:CAP.Avalonia.Services.Localization"
        x:Class="CAP.Avalonia.Views.SettingsWindow"
        x:DataType="settings:SettingsWindowViewModel"
        Title="{loc:Localize Settings.WindowTitle}"
        Width="820" Height="680"
        WindowStartupLocation="CenterOwner"
        Background="#1e1e1e"
        Foreground="White">

    <Grid ColumnDefinitions="200,1,*">

        <!-- Navigation sidebar -->
        <DockPanel Grid.Column="0" Background="#252525">
            <TextBlock DockPanel.Dock="Top"
                       Text="{loc:Localize Settings.WindowTitle}"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="White"
                       Margin="15,15,15,12"/>
            <ListBox ItemsSource="{Binding Pages}"
                     SelectedItem="{Binding SelectedPage}"
                     Background="Transparent"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type settings:ISettingsPage}">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="5,2">
                            <TextBlock Text="{Binding Icon}" VerticalAlignment="Center" FontSize="14"/>
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="Foreground" Value="#cccccc"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected">
                        <Setter Property="Background" Value="#3a3a3a"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Style>
                    <Style Selector="ListBoxItem:pointerover">
                        <Setter Property="Background" Value="#333333"/>
                    </Style>
                </ListBox.Styles>
            </ListBox>
        </DockPanel>

        <!-- Divider -->
        <Rectangle Grid.Column="1" Fill="#3d3d3d"/>

        <!-- Content area -->
        <ScrollViewer Grid.Column="2" Padding="24,20">
            <ContentControl Content="{Binding SelectedPage.ViewModel}">
                <ContentControl.DataTemplates>


                    <!-- Grid Snap & Alignment -->
                    <DataTemplate DataType="{x:Type settings:GridSnapSettingsViewModel}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{loc:Localize Settings.GridSnap.Title}" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
                            <CheckBox Content="{loc:Localize Settings.GridSnap.Enable}"
                                      IsChecked="{Binding GridSnap.IsEnabled}"
                                      Foreground="White"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{loc:Localize Settings.GridSnap.GridSize}" Foreground="Gray" VerticalAlignment="Center" Width="80"/>
                                <NumericUpDown Value="{Binding GridSnap.GridSizeMicrometers}"
                                               Minimum="1" Maximum="1000" Increment="10"
                                               Width="130" FormatString="F0"/>
                                <TextBlock Text="µm" Foreground="Gray" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>

                            <Separator Margin="0,16,0,8" Background="#3d3d3d"/>
                            <TextBlock Text="{loc:Localize Settings.GridSnap.AlignmentTitle}" FontSize="16" FontWeight="SemiBold" Foreground="Cyan" Margin="0,0,0,4"/>
                            <CheckBox Content="{loc:Localize Settings.GridSnap.ShowGuides}"
                                      IsChecked="{Binding AlignmentGuide.IsEnabled}"
                                      Foreground="White"/>
                            <TextBlock Text="{loc:Localize Settings.GridSnap.GuidesDescription}"
                                       Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DataTemplate>

                    <!-- Routing -->
                    <DataTemplate DataType="{x:Type settings:RoutingSettingsViewModel}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{loc:Localize Settings.Routing.Title}" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
                            <CheckBox Content="{loc:Localize Settings.Routing.EnableDiagonal}"
                                      IsChecked="{Binding Canvas.UseDiagonalRouting}"
                                      Foreground="White"/>
                            <TextBlock Text="{loc:Localize Settings.Routing.DiagonalDescription}"
                                       Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <Separator Margin="0,16,0,8" Background="#3d3d3d"/>
                            <TextBlock Text="{loc:Localize Settings.Routing.CrossingsTitle}" FontSize="16" FontWeight="SemiBold" Foreground="Cyan" Margin="0,0,0,4"/>
                            <CheckBox Content="{loc:Localize Settings.Routing.AdaptiveCrossing}"
                                      IsChecked="{Binding CrossingInsertionEnabled}"
                                      Foreground="White"/>
                            <TextBlock Text="{loc:Localize Settings.Routing.CrossingDescription}"
                                       Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DataTemplate>

                    <!-- Software Updates -->
                    <DataTemplate DataType="{x:Type vmUpdate:UpdateViewModel}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{loc:Localize Settings.Updates.Title}" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding CurrentVersionText}" Foreground="Gray" FontSize="11"/>

                            <Button Content="{loc:Localize Settings.Updates.Check}"
                                    Command="{Binding CheckForUpdatesCommand}"
                                    Width="150" Margin="0,8,0,0" Background="#3d4d5d"
                                    HorizontalAlignment="Left"
                                    IsEnabled="{Binding IsChecking, Converter={x:Static BoolConverters.Not}}"/>

                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                                       IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                            <StackPanel IsVisible="{Binding UpdateAvailable}" Spacing="6" Margin="0,8,0,0">
                                <TextBlock Text="{Binding LatestVersionText}"
                                           Foreground="LightGreen" FontWeight="SemiBold"/>

                                <ScrollViewer MaxHeight="120"
                                              IsVisible="{Binding ReleaseNotes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="{Binding ReleaseNotes}"
                                               Foreground="#aaaaaa" FontSize="11" TextWrapping="Wrap"/>
                                </ScrollViewer>

                                <ProgressBar Value="{Binding DownloadProgress}"
                                             Minimum="0" Maximum="1"
                                             Height="6"
                                             IsVisible="{Binding IsDownloading}"/>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{loc:Localize Settings.Updates.DownloadInstall}"
                                            Command="{Binding InstallUpdateCommand}"
                                            Background="#3d5d3d"
                                            IsEnabled="{Binding IsDownloading, Converter={x:Static BoolConverters.Not}}"/>
                                    <Button Content="{loc:Localize Settings.Updates.RemindLater}"
                                            Command="{Binding RemindLaterCommand}"
                                            Background="#3d3d3d"
                                            IsEnabled="{Binding IsDownloading, Converter={x:Static BoolConverters.Not}}"/>
                                    <Button Content="{loc:Localize Settings.Updates.SkipVersion}"
                                            Command="{Binding SkipThisVersionCommand}"
                                            Background="#5d4330"
                                            IsEnabled="{Binding IsDownloading, Converter={x:Static BoolConverters.Not}}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>

                    <!-- GDS Export (GDS toggle + Python environment) -->
                    <DataTemplate DataType="{x:Type vmExport:GdsExportViewModel}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{loc:Localize Settings.GdsExport.Title}" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
                            <TextBlock Text="{loc:Localize Settings.GdsExport.Description}"
                                       Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>

                            <CheckBox Content="{loc:Localize Settings.GdsExport.GenerateGds}"
                                      IsChecked="{Binding GenerateGdsEnabled}"
                                      Foreground="White" Margin="0,4,0,0"/>

                            <Separator Margin="0,12,0,4" Background="#3d3d3d"/>
                            <TextBlock Text="{loc:Localize Settings.GdsExport.PythonEnvTitle}" FontSize="14" FontWeight="SemiBold" Foreground="LightGray"/>
                            <TextBlock Text="{loc:Localize Settings.GdsExport.PythonEnvDescription}"
                                       Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>

                            <TextBlock Text="{loc:Localize Settings.GdsExport.ActiveInterpreter}" Foreground="Gray" FontSize="12" Margin="0,4,0,3"/>
                            <TextBox Text="{Binding CustomPythonPath}"
                                     IsReadOnly="True"
                                     Watermark="{loc:Localize Settings.GdsExport.NoInterpreter}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Python: " Foreground="Gray" Width="70"/>
                                <TextBlock Text="{Binding PythonStatus}" Foreground="White"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Nazca: " Foreground="Gray" Width="70"/>
                                <TextBlock Text="{Binding NazcaStatus}" Foreground="White"/>
                            </StackPanel>

                            <Button Content="{loc:Localize Settings.GdsExport.Manage}"
                                    Click="OnManageInterpretersClick"
                                    HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Padding="12,4" Background="#3d4d5d" FontSize="11"
                                    ToolTip.Tip="{loc:Localize Settings.GdsExport.ManageTip}"/>
                        </StackPanel>
                    </DataTemplate>

                    <!-- Python Environments (managed venvs with Nazca) -->
                    <DataTemplate DataType="{x:Type vmPyEnv:PythonEnvironmentManagerViewModel}">
                        <panels:PythonEnvironmentManagerPanel/>
                    </DataTemplate>

                    <!-- AI Assistant -->
                    <DataTemplate DataType="{x:Type vmAi:AiAssistantViewModel}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{loc:Localize Settings.Ai.Title}" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
                            <TextBlock Text="{loc:Localize Settings.Ai.Description}"
                                       Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <TextBlock Text="{loc:Localize Settings.Ai.ApiKey}" Foreground="Gray" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding ApiKey}"
                                     Watermark="sk-ant-..."
                                     PasswordChar="•"/>

                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="Gray" FontSize="11"
                                       IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </DataTemplate>

                    <!-- Chip Size — design-wide footprint of the PIC -->
                    <DataTemplate DataType="{x:Type vmCanvas:ChipSizeViewModel}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{loc:Localize Settings.ChipSize.Title}" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Localize Settings.ChipSize.Description}"
                                       Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <TextBlock Text="{loc:Localize Settings.ChipSize.Preset}" Foreground="Gray" FontSize="12" Margin="0,4,0,2"/>
                            <ComboBox ItemsSource="{Binding Presets}"
                                      SelectedItem="{Binding SelectedPreset}"
                                      DisplayMemberBinding="{Binding Name}"
                                      HorizontalAlignment="Stretch"/>

                            <TextBlock Text="{loc:Localize Settings.ChipSize.Width}" Foreground="Gray" FontSize="12" Margin="0,8,0,2"/>
                            <NumericUpDown Value="{Binding WidthMillimeters}"
                                           Minimum="0.25" Maximum="100"
                                           Increment="1" FormatString="F2"
                                           HorizontalAlignment="Stretch"/>

                            <TextBlock Text="{loc:Localize Settings.ChipSize.Height}" Foreground="Gray" FontSize="12" Margin="0,8,0,2"/>
                            <NumericUpDown Value="{Binding HeightMillimeters}"
                                           Minimum="0.25" Maximum="100"
                                           Increment="1" FormatString="F2"
                                           HorizontalAlignment="Stretch"/>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{loc:Localize Settings.ChipSize.GridPrefix}" Foreground="Gray" FontSize="11"/>
                                <TextBlock Text="{Binding TileColumns}" Foreground="LightGray" FontSize="11"/>
                                <TextBlock Text=" × " Foreground="Gray" FontSize="11"/>
                                <TextBlock Text="{Binding TileRows}" Foreground="LightGray" FontSize="11"/>
                                <TextBlock Text="{loc:Localize Settings.ChipSize.TilesSuffix}" Foreground="Gray" FontSize="11"/>
                            </StackPanel>

                            <Button Content="{loc:Localize Common.Apply}"
                                    Command="{Binding ApplyCommand}"
                                    HorizontalAlignment="Left" Padding="16,4"
                                    Background="#3d5d5d"
                                    Margin="0,12,0,0"/>

                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="LightGreen" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                                       IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </DataTemplate>

                    <!-- Interconnect defaults (issue #574) -->
                    <DataTemplate DataType="{x:Type settings:InterconnectSettingsViewModel}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{loc:Localize Settings.Interconnect.Title}" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
                            <TextBlock Text="{loc:Localize Settings.Interconnect.Description}"
                                       Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{loc:Localize Settings.Interconnect.Width}" Foreground="Gray" VerticalAlignment="Center" Width="100"/>
                                <NumericUpDown Value="{Binding WidthMicrometers}"
                                               Minimum="0.05" Maximum="100" Increment="0.05"
                                               Width="130" FormatString="F2"/>
                                <TextBlock Text="µm" Foreground="Gray" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:Localize Settings.Interconnect.BendRadius}" Foreground="Gray" VerticalAlignment="Center" Width="100"/>
                                <NumericUpDown Value="{Binding BendRadiusMicrometers}"
                                               Minimum="0.5" Maximum="10000" Increment="1"
                                               Width="130" FormatString="F1"/>
                                <TextBlock Text="µm" Foreground="Gray" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:Localize Settings.Interconnect.GdsLayer}" Foreground="Gray" VerticalAlignment="Center" Width="100"/>
                                <TextBox Text="{Binding GdsLayerText}" Width="130" Watermark="{loc:Localize Settings.Interconnect.GdsLayerWatermark}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                                <Button Content="{loc:Localize Settings.Interconnect.Apply}"
                                        Command="{Binding ApplyCommand}"
                                        Padding="16,4" Background="#3d5d5d"/>
                                <Button Content="{loc:Localize Settings.Interconnect.Reset}"
                                        Command="{Binding ResetToDefaultsCommand}"
                                        Padding="16,4"/>
                            </StackPanel>

                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="LightGreen" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                                       IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </DataTemplate>

                    <!-- Language — UI language picker (issue #744) -->
                    <DataTemplate DataType="{x:Type settings:LanguageSettingsViewModel}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{loc:Localize Settings.Language.Title}" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
                            <TextBlock Text="{loc:Localize Settings.Language.Description}"
                                       Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>

                            <TextBlock Text="{loc:Localize Settings.Language.PickerLabel}" Foreground="Gray" FontSize="12" Margin="0,4,0,2"/>
                            <ComboBox ItemsSource="{Binding Options}"
                                      SelectedItem="{Binding SelectedOption}"
                                      HorizontalAlignment="Stretch"/>

                            <TextBlock Text="{loc:Localize Settings.Language.RestartNote}"
                                       Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </DataTemplate>

                </ContentControl.DataTemplates>
            </ContentControl>
        </ScrollViewer>

    </Grid>
</Window>
