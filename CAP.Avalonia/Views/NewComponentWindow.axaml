<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CAP.Avalonia.ViewModels.Components.AddCustomComponent"
        xmlns:edit="using:AvaloniaEdit"
        xmlns:behaviors="using:CAP.Avalonia.Behaviors"
        xmlns:controls="using:CAP.Avalonia.Controls"
        xmlns:cs="using:CAP.Avalonia.ViewModels.ComponentSettings"
        xmlns:solvers="using:CAP.Avalonia.ViewModels.Solvers"
        xmlns:loc="using:CAP.Avalonia.Services.Localization"
        x:Class="CAP.Avalonia.Views.NewComponentWindow"
        x:DataType="vm:NewComponentViewModel"
        Title="{Binding WindowTitle}"
        Width="520" Height="800"
        MinWidth="440" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#1e1e1e"
        Foreground="White">

    <DockPanel Margin="16" LastChildFill="True">

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="{Binding SaveButtonLabel}" Command="{Binding SaveCommand}"
                    MinWidth="130" Padding="14,4" Background="#2a4a2a"
                    ToolTip.Tip="{loc:Localize NewComponent.SaveTip}"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      AllowAutoHide="False">
            <StackPanel Spacing="10">

                <Border Background="#2a2440" CornerRadius="3" Padding="8,5" IsVisible="{Binding IsEditMode}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:Localize NewComponent.EditModeHeader}"
                                   FontWeight="Bold" FontSize="11" Foreground="#c9b3ff"/>
                        <TextBlock Text="{loc:Localize NewComponent.EditModeDescription}"
                                   FontSize="10" Foreground="#9aa0b0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="PDK" Foreground="#aaaaaa" FontSize="11" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding PdkChoices}"
                          SelectedItem="{Binding SelectedPdkChoice}"
                          Background="#2d2d2d" Foreground="White" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PdkChoice">
                            <TextBlock Text="{Binding DisplayName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Separator Background="#3d3d3d"/>

                <TextBlock Text="{loc:Localize NewComponent.FabricationProcess}" Foreground="#aaaaaa" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SelectedProcess.Name}" Foreground="White" FontSize="12"/>

                <Separator Background="#3d3d3d"/>

                <TextBlock Text="{loc:Localize NewComponent.Name}" Foreground="#aaaaaa" FontSize="11" FontWeight="SemiBold"/>
                <TextBox Text="{Binding ComponentName}" Background="#2d2d2d" Foreground="White"/>

                <Separator Background="#3d3d3d"/>

                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="{loc:Localize NewComponent.StructureLabel}" Foreground="#aaaaaa" FontSize="11"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <controls:HelpFlyoutButton Grid.Column="1" Title="{loc:Localize NewComponent.HelpTitle}" Margin="0,0,6,0">
                        <controls:HelpFlyoutButton.HelpContent>
                            <StackPanel Spacing="8" MaxWidth="380">
                                <TextBlock TextWrapping="Wrap" Foreground="#dddddd" FontSize="11"
                                           Text="{loc:Localize NewComponent.HelpBody}"/>
                                <TextBlock Text="{loc:Localize NewComponent.GdsFactoryExample}" Foreground="#aaaacc" FontSize="10" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" x:Name="GdsFactoryExampleBox" IsReadOnly="True"
                                             Text="import gdsfactory as gf&#10;component = gf.components.mmi1x2()"
                                             AcceptsReturn="True" TextWrapping="NoWrap"
                                             FontFamily="Consolas, Cascadia Mono, Courier New, monospace" FontSize="10"
                                             Background="#101018" Foreground="#dddddd"/>
                                    <Button Grid.Column="1" Content="{loc:Localize Context.Copy}" Click="OnCopyGdsFactoryExample"
                                            FontSize="10" Padding="6,1" Margin="4,0,0,0" VerticalAlignment="Top"
                                            Background="#33335a" Foreground="#ccccff" BorderThickness="0"/>
                                </Grid>
                                <TextBlock Text="{loc:Localize NewComponent.NazcaExample}" Foreground="#aaaacc" FontSize="10" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" x:Name="NazcaExampleBox" IsReadOnly="True"
                                             Text="import nazca as nd&#10;&#10;def component():&#10;    with nd.Cell(name='my_component') as c:&#10;        nd.strt(length=20, width=0.5).put(0)&#10;        nd.Pin('a0').put(0, 0, 180)&#10;        nd.Pin('b0').put(20, 0, 0)&#10;    return c"
                                             AcceptsReturn="True" TextWrapping="NoWrap"
                                             FontFamily="Consolas, Cascadia Mono, Courier New, monospace" FontSize="10"
                                             Background="#101018" Foreground="#dddddd"/>
                                    <Button Grid.Column="1" Content="{loc:Localize Context.Copy}" Click="OnCopyNazcaExample"
                                            FontSize="10" Padding="6,1" Margin="4,0,0,0" VerticalAlignment="Top"
                                            Background="#33335a" Foreground="#ccccff" BorderThickness="0"/>
                                </Grid>
                            </StackPanel>
                        </controls:HelpFlyoutButton.HelpContent>
                    </controls:HelpFlyoutButton>
                    <Button Grid.Column="2" Content="{loc:Localize NewComponent.LoadFromPy}" Command="{Binding LoadCodeFromFileCommand}"
                            Background="#3d4d6d" FontSize="11"
                            ToolTip.Tip="{loc:Localize NewComponent.LoadFromPyTip}"/>
                </Grid>

                <edit:TextEditor behaviors:TextEditorBindingBehavior.BoundText="{Binding Code, Mode=TwoWay}"
                                  ShowLineNumbers="True"
                                  WordWrap="False"
                                  FontFamily="Consolas, Cascadia Mono, Courier New, monospace"
                                  FontSize="11"
                                  Height="200"
                                  Background="#151515" Foreground="#dddddd"
                                  BorderBrush="#3d3d3d" BorderThickness="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"/>

                <Grid ColumnDefinitions="Auto,8,*,8,Auto">
                    <TextBlock Grid.Column="0" Text="{loc:Localize NewComponent.Backend}" Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding AvailableBackends}"
                              SelectedItem="{Binding SelectedBackend}"
                              Background="#2d2d2d" Foreground="White" HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="4" Content="{loc:Localize NewComponent.Preview}" Command="{Binding RunPreviewCommand}"
                            Width="90" Background="#3d4d6d"
                            ToolTip.Tip="{loc:Localize NewComponent.PreviewTip}"/>
                </Grid>

                <Image x:Name="PreviewThumbnail"
                       Source="{Binding PreviewBitmap}"
                       Height="120"
                       Stretch="Uniform"
                       HorizontalAlignment="Left"
                       Cursor="Hand"
                       IsVisible="{Binding PreviewBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"
                       PointerPressed="OnPreviewThumbnailPointerPressed"
                       ToolTip.Tip="{loc:Localize NewComponent.ClickToEnlarge}"/>

                <Separator Background="#3d3d3d"/>

                <TextBlock Text="S-matrix" Foreground="#aaaaaa" FontSize="11" FontWeight="SemiBold"/>
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <!-- Split button: compute with the selected backend; ▼ picks the backend. -->
                        <StackPanel Orientation="Horizontal" Spacing="0">
                            <Button Content="{Binding ComputeButtonLabel}" Command="{Binding ComputeSMatrixCommand}"
                                    Padding="12,2" Height="26" Background="#3d4d6d"
                                    ToolTip.Tip="{loc:Localize NewComponent.ComputeTip}"/>
                            <Button Content="▼"
                                    Padding="8,2" Height="26"
                                    FontSize="9"
                                    Background="#2d3d5d"
                                    VerticalContentAlignment="Center"
                                    IsVisible="{Binding HasBackendSelection}"
                                    ToolTip.Tip="{loc:Localize CompSettings.BackendPickerTip}">
                                <Button.IsEnabled>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="IsBusy" Converter="{x:Static BoolConverters.Not}"/>
                                        <Binding Path="IsAwaitingCloudConfirmation" Converter="{x:Static BoolConverters.Not}"/>
                                    </MultiBinding>
                                </Button.IsEnabled>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                        <StackPanel MinWidth="280" Margin="6" Spacing="2">
                                            <TextBlock Text="{loc:Localize CompSettings.ChooseFdtdBackend}"
                                                       Foreground="Gray" FontSize="11" Margin="0,0,0,6"/>
                                            <ItemsControl ItemsSource="{Binding BackendSelection.BackendItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="solvers:FdtdBackendItemViewModel">
                                                        <Button HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Left"
                                                                Margin="0,2" Padding="10,4"
                                                                Background="#2b2b3d"
                                                                Command="{Binding SelectCommand}">
                                                            <Grid ColumnDefinitions="22,*">
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding SelectionMark}"
                                                                           Foreground="#88ccaa"
                                                                           FontSize="12"
                                                                           VerticalAlignment="Top"
                                                                           Margin="0,1,0,0"/>
                                                                <StackPanel Grid.Column="1">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <TextBlock Text="{Binding Icon}" FontSize="13"/>
                                                                        <TextBlock Text="{Binding Name}"
                                                                                   Foreground="White"
                                                                                   FontWeight="SemiBold"
                                                                                   FontSize="12"
                                                                                   VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding Description}"
                                                                               Foreground="#aaaaaa"
                                                                               FontSize="9"
                                                                               TextWrapping="Wrap"
                                                                               MaxWidth="230"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <Button Content="{loc:Localize NewComponent.LoadFromFile}" Command="{Binding LoadSMatrixFromFileCommand}"
                                Background="#3d5d3d"
                                ToolTip.Tip="{loc:Localize NewComponent.LoadSMatrixTip}"/>
                        <Button Content="{loc:Localize NewComponent.ShowStoredSMatrices}" Command="{Binding ShowSMatricesCommand}"
                                Background="#3d3d5d"
                                ToolTip.Tip="{loc:Localize NewComponent.ShowStoredSMatricesTip}"/>
                    </StackPanel>

                    <!-- Amber hint when the selected backend can't run yet (Docker down / no API key). -->
                    <Border Background="#26261a"
                            BorderBrush="#5d5330"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,6"
                            IsVisible="{Binding BackendSelection.HasAvailabilityHint, FallbackValue=False}">
                        <StackPanel Spacing="4"
                                    DataContext="{Binding BackendSelection}"
                                    x:DataType="solvers:FdtdBackendSelectionViewModel">
                            <TextBlock Text="{Binding AvailabilityHint}"
                                       Foreground="#ccaa66"
                                       FontSize="10"
                                       TextWrapping="Wrap"/>
                            <Button Content="{loc:Localize CompSettings.Tidy3dGetKeyLink}"
                                    Command="{Binding OpenTidy3dPortalCommand}"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#7faaff"
                                    FontSize="10"
                                    HorizontalAlignment="Left"
                                    Cursor="Hand"
                                    IsVisible="{Binding ShowMissingKeyLink}"/>
                        </StackPanel>
                    </Border>

                    <!-- Cloud cost confirmation: Tidy3D runs consume credits, so nothing is
                         submitted until the user reviews the estimate and confirms. -->
                    <Border Background="#26261a"
                            BorderBrush="#5d5330"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,6"
                            IsVisible="{Binding IsAwaitingCloudConfirmation}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding CloudCostText}"
                                       Foreground="#ddcc88" FontSize="11" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{loc:Localize CompSettings.CloudSubmit}"
                                        Command="{Binding ConfirmCloudSubmitCommand}"
                                        Padding="12,2" Background="#5d4330"/>
                                <Button Content="{loc:Localize Common.Cancel}"
                                        Command="{Binding CancelCloudSubmitCommand}"
                                        Padding="12,2" Background="#3d3d3d"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="4" Background="#2d2d2d"/>
                <!-- SelectableTextBlock so error messages can be copied (field round 6). -->
                <SelectableTextBlock Text="{Binding StatusText}" Foreground="#dddddd" FontSize="11" TextWrapping="Wrap"
                                     SelectionBrush="#3d5d8d"/>

                <Expander Header="{loc:Localize NewComponent.SMatrixData}" IsExpanded="False"
                          IsVisible="{Binding HasSMatrix}" Background="#161616">
                    <ItemsControl ItemsSource="{Binding SMatrixEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="cs:SMatrixEntryViewModel">
                                <Border Background="#252526" CornerRadius="4" Padding="8,6" Margin="0,2">
                                    <Grid ColumnDefinitions="110,80,*">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding WavelengthLabel}" Foreground="White"
                                                       FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="{Binding SourceNote}" Foreground="#666666" FontSize="9"
                                                       IsVisible="{Binding SourceNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Dimensions}" Foreground="#aaaaaa"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MagnitudePreview}" Foreground="#88ccaa"
                                                       FontFamily="Consolas, Courier New, monospace" FontSize="10"
                                                       TextWrapping="NoWrap"/>
                                            <TextBlock Text="{Binding PortNamesDisplay}" Foreground="#666666" FontSize="9"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
