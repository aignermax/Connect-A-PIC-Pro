<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CAP.Avalonia.ViewModels.Export"
        xmlns:loc="using:CAP.Avalonia.Services.Localization"
        x:Class="CAP.Avalonia.Views.Dialogs.VerilogAExportDialog"
        x:DataType="vm:VerilogAExportViewModel"
        Title="{loc:Localize VerilogAExport.Title}"
        Width="440" Height="380"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#1e1e1e"
        Foreground="White">

    <DockPanel Margin="16" LastChildFill="True">

        <!-- Buttons docked at the bottom so they're always visible -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="{loc:Localize Common.OpenFolder}"
                    Command="{Binding OpenOutputDirectoryCommand}"
                    Width="100" Background="#2d4d3d" FontSize="11"
                    IsVisible="{Binding LastExportSucceeded}"/>
            <Button Content="{loc:Localize Common.ExportEllipsis}"
                    Command="{Binding ExportCommand}"
                    Width="90" Background="#3d6d4d"
                    IsEnabled="{Binding IsExporting, Converter={x:Static BoolConverters.Not}}"/>
            <Button Content="{loc:Localize Common.Close}" x:Name="CloseButton" Width="70" Click="OnCloseClicked"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="10">
            <TextBlock Text="{loc:Localize VerilogAExport.Heading}" FontSize="15" FontWeight="SemiBold"
                       Foreground="#7BC8A4"/>
            <TextBlock Text="{loc:Localize VerilogAExport.Description}"
                       Foreground="Gray" FontSize="10" TextWrapping="Wrap"/>

            <Separator Background="#3d3d3d"/>

            <!-- Wavelength -->
            <TextBlock Text="{loc:Localize VerilogAExport.WavelengthLabel}" Foreground="Gray" FontSize="11"/>
            <ComboBox ItemsSource="{Binding WavelengthOptions}"
                      SelectedValue="{Binding WavelengthNm}"
                      HorizontalAlignment="Stretch"
                      Background="#2d2d2d"/>

            <!-- Options -->
            <CheckBox Content="{loc:Localize VerilogAExport.IncludeTestBench}"
                      IsChecked="{Binding IncludeTestBench}"
                      Foreground="White"/>

            <!-- Tooling requirements: tells the user up-front which simulator
                 chain the generated files target. Mirko hit this when the
                 modules looked like "weird Verilog-A" in his usual flow —
                 they're correct for OpenVAF + NGSpice OSDI, not arbitrary SPICE. -->
            <Expander Header="{loc:Localize VerilogAExport.CaveatsHeader}"
                      Foreground="LightGray" FontSize="10"
                      IsExpanded="False">
                <TextBlock Foreground="LightGray" FontSize="10" TextWrapping="Wrap"
                           Text="{loc:Localize VerilogAExport.CaveatsBody}"/>
            </Expander>

            <!-- Status -->
            <TextBlock Text="{Binding StatusText}"
                       Foreground="LightGreen" FontSize="10" TextWrapping="Wrap"
                       IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
