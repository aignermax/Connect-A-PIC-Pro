<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CAP.Avalonia.ViewModels.PdkResolution"
        xmlns:loc="using:CAP.Avalonia.Services.Localization"
        x:Class="CAP.Avalonia.Views.Dialogs.PdkResolutionCheckDialog"
        x:DataType="vm:PdkResolutionCheckViewModel"
        Title="{loc:Localize PdkCheck.WindowTitle}"
        Width="720" Height="560"
        MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#1e1e1e"
        Foreground="White">

    <DockPanel Margin="16" LastChildFill="True">

        <!-- Buttons — always visible at the bottom -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="{loc:Localize PdkCheck.CopyFailingList}"
                    Command="{Binding CopyFailingListCommand}"
                    Background="#3d3d3d" FontSize="11"
                    IsEnabled="{Binding HasFailures}"
                    ToolTip.Tip="{loc:Localize PdkCheck.CopyFailingListTip}"/>
            <Button Content="{loc:Localize PdkCheck.RunCheck}"
                    Command="{Binding RunCheckCommand}"
                    Width="100" Background="#3d4d6d"
                    IsEnabled="{Binding !IsRunning}"/>
            <Button Content="{loc:Localize Common.Close}" Width="70" Click="OnCloseClicked"/>
        </StackPanel>

        <!-- Status line -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}"
                   Foreground="#dddddd" FontSize="11" TextWrapping="Wrap"
                   Margin="0,8,0,0"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="10">

                <TextBlock Text="{loc:Localize PdkCheck.Title}" FontSize="15" FontWeight="SemiBold"
                           Foreground="LightBlue"/>
                <TextBlock Text="{loc:Localize PdkCheck.Description}"
                           Foreground="Gray" FontSize="10" TextWrapping="Wrap"/>

                <Separator Background="#3d3d3d"/>

                <!-- Per-PDK groups -->
                <ItemsControl ItemsSource="{Binding Pdks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PdkResolutionGroupViewModel">
                            <StackPanel Spacing="4" Margin="0,0,0,12">

                                <!-- PDK header -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding PdkName}" Foreground="#aaccff"
                                               FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding FileName}" Foreground="Gray" FontSize="11"/>
                                    <TextBlock Text="{Binding Summary}" Foreground="#aaaaaa" FontSize="11"/>
                                </StackPanel>

                                <!-- Load / run-level error -->
                                <TextBlock Text="{Binding Error}" Foreground="#ff9999" FontSize="11"
                                           TextWrapping="Wrap" IsVisible="{Binding HasError}"/>

                                <!-- Component rows -->
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PdkResolutionRowViewModel">
                                            <Border Padding="4,2" Background="Transparent">
                                                <Grid ColumnDefinitions="28,180,170,*">
                                                    <TextBlock Grid.Column="0" Text="{Binding StatusBadge}" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ComponentName}"
                                                               Foreground="White" FontSize="11"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding FunctionPath}"
                                                               Foreground="#bbbbbb" FontSize="11" FontFamily="Monospace"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Message}"
                                                               Foreground="{Binding StatusColor}" FontSize="11"
                                                               TextWrapping="Wrap"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</Window>
