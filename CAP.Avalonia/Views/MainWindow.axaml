<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CAP.Avalonia.ViewModels"
        xmlns:vmLib="using:CAP.Avalonia.ViewModels.Library"
        xmlns:diagnostics="using:CAP.Avalonia.ViewModels.Diagnostics"
        xmlns:creation="using:CAP_Core.Components.Creation"
        xmlns:controls="using:CAP.Avalonia.Controls"
        xmlns:views="using:CAP.Avalonia.Views"
        xmlns:behaviors="using:CAP.Avalonia.Behaviors"
        xmlns:panels="using:CAP.Avalonia.Views.Panels"
        xmlns:vmTrash="using:CAP.Avalonia.ViewModels.Panels.PdkTrash"
        xmlns:loc="using:CAP.Avalonia.Services.Localization"
        x:Class="CAP.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Width="1800" Height="900">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+G" Command="{Binding CreateGroupCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+G" Command="{Binding UngroupCommand}" />
        <KeyBinding Gesture="F12" Command="{Binding BottomPanel.ErrorConsole.ToggleCommand}" />
    </Window.KeyBindings>

    <Window.Styles>
        <!-- Compact left-panel group lists: the Fluent ListBoxItem default padding/min-height
             adds a lot of dead space between rows. Scoped via the compactList class so other
             list boxes keep the default chrome. -->
        <Style Selector="ListBox.compactList">
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.compactList ListBoxItem">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
    </Window.Styles>

    <Grid>
    <DockPanel>
        <!-- Toolbar -->
        <ScrollViewer DockPanel.Dock="Top"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      Background="#2d2d2d"
                      Height="40">
            <StackPanel Orientation="Horizontal">
                <!-- Home -->
                <Button Command="{Binding ShowHomeCommand}"
                        Width="36" Margin="10,2,2,2" Background="#3d3d3d"
                        ToolTip.Tip="{loc:Localize Home.ToolbarTip}">
                    <PathIcon Data="M8,1.5 L15,7.5 L13.5,7.5 L13.5,14 L9.5,14 L9.5,10 L6.5,10 L6.5,14 L2.5,14 L2.5,7.5 L1,7.5 Z"
                              Width="16" Height="16" Foreground="LightBlue"/>
                </Button>

                <Separator Width="1" Background="Gray" Margin="10,5"/>

                <!-- Mode Buttons — icon-only, tooltips name the mode and its shortcut -->
                <TextBlock Text="{loc:Localize Toolbar.ModeLabel}" VerticalAlignment="Center" Margin="10,0,5,0" Foreground="White"/>
                <Button Command="{Binding SetSelectModeCommand}"
                        Width="36" Margin="2" Background="#3d3d3d"
                        ToolTip.Tip="{loc:Localize Toolbar.SelectModeTip}">
                    <PathIcon Data="M5,2 L5,13.5 L8,10.8 L9.8,14.6 L11.7,13.7 L9.9,10 L13.5,9.6 Z"
                              Width="16" Height="16" Foreground="LightBlue"/>
                </Button>
                <Button Command="{Binding SetConnectModeCommand}"
                        Width="36" Margin="2" Background="#3d3d3d"
                        ToolTip.Tip="{loc:Localize Toolbar.ConnectModeTip}">
                    <PathIcon Data="M2,10 L5,10 L5,13 L2,13 Z M11,3 L14,3 L14,6 L11,6 Z M4.6,11.2 L11.2,4.6 L12.4,5.8 L5.8,12.4 Z"
                              Width="16" Height="16" Foreground="Orange"/>
                </Button>
                <Button Command="{Binding SetDeleteModeCommand}"
                        Width="36" Margin="2" Background="#3d3d3d"
                        ToolTip.Tip="{loc:Localize Toolbar.DeleteModeTip}">
                    <PathIcon Data="M3,4.4 L4.4,3 L8,6.6 L11.6,3 L13,4.4 L9.4,8 L13,11.6 L11.6,13 L8,9.4 L4.4,13 L3,11.6 L6.6,8 Z"
                              Width="16" Height="16" Foreground="Red"/>
                </Button>
                <Button Command="{Binding SetProbeModeCommand}"
                        Width="36" Margin="2" Background="#3d3d3d"
                        ToolTip.Tip="{loc:Localize Toolbar.ProbeModeTip}">
                    <!-- magnifier-over-wave icon -->
                    <PathIcon Data="M6.5,2 A4.5,4.5 0 1 0 6.5,11 A4.5,4.5 0 1 0 6.5,2 Z M6.5,3.5 A3,3 0 1 1 6.5,9.5 A3,3 0 1 1 6.5,3.5 Z M10.2,10.2 L14,14 L12.9,15.1 L9.1,11.3 Z M4.5,6.5 Q5.5,5 6.5,6.5 Q7.5,8 8.5,6.5"
                              Width="16" Height="16" Foreground="#8FD3A7"/>
                </Button>
                <Button Command="{Binding SetCutModeCommand}"
                        Width="36" Margin="2" Background="#3d3d3d"
                        ToolTip.Tip="{loc:Localize Toolbar.CutModeTip}">
                    <!-- scissors icon -->
                    <PathIcon Data="M4,2.5 A1.8,1.8 0 1 0 4,6.1 A1.8,1.8 0 1 0 4,2.5 Z M4,3.6 A0.7,0.7 0 1 1 4,5 A0.7,0.7 0 1 1 4,3.6 Z M4,9.9 A1.8,1.8 0 1 0 4,13.5 A1.8,1.8 0 1 0 4,9.9 Z M4,11 A0.7,0.7 0 1 1 4,12.4 A0.7,0.7 0 1 1 4,11 Z M5.6,5.6 L13.5,12.2 L12.2,13 L7,9.2 Z M5.6,10.4 L13.5,3.8 L12.2,3 L7,6.8 Z"
                              Width="16" Height="16" Foreground="Gold"/>
                </Button>

                <Separator Width="1" Background="Gray" Margin="10,5"/>

                <!-- Zoom Controls -->
                <Button Content="+" Command="{Binding ZoomInCommand}" Width="30" Margin="2"/>
                <Button Content="-" Command="{Binding ZoomOutCommand}" Width="30" Margin="2"/>
                <Button x:Name="ZoomToFitButton" Click="ZoomToFitButton_Click"
                        Width="36" Margin="2" Background="#3d3d3d" ToolTip.Tip="{loc:Localize Toolbar.ZoomToFitTip}">
                    <PathIcon Data="M2,2 L6,2 L6,4 L4,4 L4,6 L2,6 Z M10,2 L14,2 L14,6 L12,6 L12,4 L10,4 Z M2,10 L4,10 L4,12 L6,12 L6,14 L2,14 Z M12,10 L14,10 L14,14 L10,14 L10,12 L12,12 Z M6.5,6.5 L9.5,6.5 L9.5,9.5 L6.5,9.5 Z"
                              Width="16" Height="16" Foreground="White"/>
                </Button>

                <!-- Simulation — icon-only (play triangle), next to Fit per field feedback -->
                <Button Command="{Binding RunSimulationCommand}"
                        Width="36" Margin="2" Background="#3d5d3d"
                        ToolTip.Tip="{loc:Localize Toolbar.RunSimulationTip}">
                    <PathIcon Data="M4.5,2.5 L13.5,8 L4.5,13.5 Z"
                              Width="16" Height="16" Foreground="LightGreen"/>
                </Button>

                <!-- Simulation mode: CW vs Transient. Run (L) executes the active mode. -->
                <ComboBox Width="120" Margin="2" VerticalAlignment="Center"
                          SelectedIndex="{Binding SimulationModeIndex}"
                          ToolTip.Tip="{loc:Localize Toolbar.SimulationModeTip}">
                    <ComboBoxItem>CW</ComboBoxItem>
                    <ComboBoxItem>Transient</ComboBoxItem>
                </ComboBox>

                <Separator Width="1" Background="Gray" Margin="10,5"/>

                <!-- Undo/Redo -->
                <Button Content="↶" Command="{Binding UndoCommand}"
                        Width="30" Margin="2" Background="#3d3d3d" ToolTip.Tip="{loc:Localize Toolbar.UndoTip}"/>
                <Button Content="↷" Command="{Binding RedoCommand}"
                        Width="30" Margin="2" Background="#3d3d3d" ToolTip.Tip="{loc:Localize Toolbar.RedoTip}"/>

                <Separator Width="1" Background="Gray" Margin="10,5"/>

                <!-- Group/Ungroup — icon-only, the tooltips carry the label -->
                <Button Command="{Binding CreateGroupCommand}"
                        Width="36" Margin="2" Background="#3d3d3d" ToolTip.Tip="{loc:Localize Toolbar.CreateGroupTip}">
                    <PathIcon Data="M4,4 L12,4 L12,12 L4,12 Z M6,6 L10,6 L10,10 L6,10 Z"
                              Width="16" Height="16" Foreground="LightBlue"/>
                </Button>

                <Button Command="{Binding UngroupCommand}"
                        Width="36" Margin="2" Background="#3d3d3d" ToolTip.Tip="{loc:Localize Toolbar.UngroupTip}">
                    <PathIcon Data="M4,4 L6,4 L6,6 L4,6 Z M10,4 L12,4 L12,6 L10,6 Z M4,10 L6,10 L6,12 L4,12 Z M10,10 L12,10 L12,12 L10,12 Z"
                              Width="16" Height="16" Foreground="Orange"/>
                </Button>

                <Separator Width="1" Background="Gray" Margin="10,5"/>

                <!-- File Operations -->
                <Button Content="📄" Command="{Binding NewProjectCommand}"
                        Width="36" Margin="2" Background="#3d3d3d" ToolTip.Tip="{loc:Localize Toolbar.NewProjectTip}"/>
                <Button Content="📂" Command="{Binding LoadDesignCommand}"
                        Width="36" Margin="2" Background="#3d3d3d" ToolTip.Tip="{loc:Localize Toolbar.LoadDesignTip}"/>
                <Button Content="💾" Command="{Binding SaveDesignCommand}"
                        Width="36" Margin="2" Background="#3d3d3d" ToolTip.Tip="{loc:Localize Toolbar.SaveDesignTip}"/>
                <Button Content="💾+" Command="{Binding SaveDesignAsCommand}"
                        Width="50" Margin="2" Background="#3d3d3d" ToolTip.Tip="{loc:Localize Toolbar.SaveDesignAsTip}"/>
                <!-- Unified Export flyout — add formats via IExportFormat + ExportMenuViewModel, no axaml changes needed -->
                <Button MinWidth="95" Margin="2" Padding="8,4" Background="#3d4d3d"
                        ToolTip.Tip="{loc:Localize Toolbar.ExportTip}">
                    <Button.Content>
                        <TextBlock Text="{loc:Localize Toolbar.ExportButton}"/>
                    </Button.Content>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                            <StackPanel MinWidth="240" Margin="6">
                                <TextBlock Text="{loc:Localize Toolbar.ChooseExportFormat}" Foreground="Gray"
                                           FontSize="11" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding ExportMenu.Formats}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Margin="0,2" Padding="10,3"
                                                    Command="{Binding ExportCommand}"
                                                    Background="{Binding Background}"
                                                    ToolTip.Tip="{Binding Description}">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{Binding Icon}" FontSize="15"
                                                               VerticalAlignment="Center"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="White"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="12"/>
                                                        <TextBlock Text="{Binding Description}"
                                                                   Foreground="#aaaaaa"
                                                                   FontSize="9"
                                                                   TextWrapping="Wrap"
                                                                   MaxWidth="180"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Separator Width="1" Background="Gray" Margin="10,5"/>

                <!-- Tools -->
                <Button MinWidth="80" Margin="2" Padding="8,4" Background="#3d3d5d"
                        ToolTip.Tip="{loc:Localize Toolbar.ToolsTip}">
                    <Button.Content>
                        <TextBlock Text="{loc:Localize Toolbar.ToolsButton}"/>
                    </Button.Content>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                            <StackPanel MinWidth="230" Margin="6">
                                <!-- Load PDK + format help share one row: the ❓ opens the
                                     PDK JSON documentation the loader expects. -->
                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                    <Button Grid.Column="0" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Padding="10,3"
                                            Background="#3d3d5d"
                                            Command="{Binding LoadPdkCommand}"
                                            ToolTip.Tip="{loc:Localize Toolbar.LoadPdkTip}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="📦" FontSize="15" VerticalAlignment="Center"/>
                                            <TextBlock Text="{loc:Localize Toolbar.LoadPdk}"
                                                       Foreground="White" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Width="32" Margin="4,0,0,0" Padding="2,7"
                                            Background="#3d3d5d"
                                            Command="{Binding OpenPdkHelpCommand}"
                                            ToolTip.Tip="{loc:Localize Toolbar.PdkHelpTip}"
                                            Content="❓"/>
                                </Grid>

                                <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Margin="0,2" Padding="10,3"
                                        Background="#3d3d5d"
                                        Command="{Binding OpenPdkOffsetEditorCommand}"
                                        ToolTip.Tip="{loc:Localize Toolbar.PdkOffsetEditorTip}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="📐" FontSize="15" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Localize Toolbar.PdkOffsetEditor}"
                                                   Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </Button>

                                <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Margin="0,2" Padding="10,3"
                                        Background="#3d3d5d"
                                        Click="OpenModeSolverDialog_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="📡" FontSize="15" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Localize Toolbar.ComputeModes}"
                                                   Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Margin="0,2" Padding="10,3"
                                        Background="#3d3d5d"
                                        Click="OpenPdkResolutionCheckDialog_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="🔎" FontSize="15" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Localize Toolbar.CheckPdks}"
                                                   Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <!-- Component Registry browser window (#656): same window as the
                                     🌐 button in the Component Library header. -->
                                <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Margin="0,2" Padding="10,3"
                                        Background="#3d3d5d"
                                        Click="OpenRegistryBrowser_Click"
                                        ToolTip.Tip="{loc:Localize Registry.OpenTip}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="🌐" FontSize="15" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Localize Toolbar.ComponentRegistry}"
                                                   Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </Button>

                                <!-- Unlock All (components & connections) — replaces the former
                                     "Lock Elements" properties-panel section (issue: drop that
                                     section, keep the unlock-all function reachable here). -->
                                <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Margin="0,2" Padding="10,3"
                                        Background="#3d3d5d"
                                        Command="{Binding BottomPanel.ElementLock.UnlockAllCommand}"
                                        ToolTip.Tip="{loc:Localize Toolbar.UnlockAllTip}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="🔓" FontSize="15" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Localize Toolbar.UnlockAll}"
                                                   Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Separator Width="1" Background="Gray" Margin="10,5"/>

                <!-- Settings -->
                <Button Command="{Binding OpenSettingsWindowCommand}"
                        Width="36" Margin="2" Background="#3d3d3d" ToolTip.Tip="{loc:Localize Toolbar.SettingsTip}">
                    <TextBlock Text="⚙" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border DockPanel.Dock="Bottom" Background="#1e1e1e" Height="25">
            <DockPanel LastChildFill="True">
                <!-- Active process indicator (issue #570): persistent, low-clutter home in the
                     status bar (right) rather than the crowded top toolbar. Green = a real
                     process; amber = Playground (not manufacturable); "No process selected" until
                     one is chosen via File → New. -->
                <Border DockPanel.Dock="Right" x:Name="ActiveProcessIndicator"
                        Margin="6,3" Padding="8,1" CornerRadius="3" VerticalAlignment="Center"
                        Background="#2d4d2d" Classes.playground="{Binding IsPlayground}"
                        ToolTip.Tip="{loc:Localize StatusBar.ActiveProcessTip}">
                    <Border.Styles>
                        <Style Selector="Border.playground">
                            <Setter Property="Background" Value="#5d4510"/>
                        </Style>
                    </Border.Styles>
                    <TextBlock Text="{Binding ActiveProcessLabel}"
                               Foreground="White" FontSize="10" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusText}"
                               VerticalAlignment="Center" Margin="10,0" Foreground="LightGray"/>
                    <TextBlock VerticalAlignment="Center" Margin="20,0,0,0" Foreground="Gray"
                               Text="{loc:Localize StatusBar.ShortcutHints}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Error Console Panel (collapsible, above status bar, toggled via F12) -->
        <Border DockPanel.Dock="Bottom" Background="#161616" BorderThickness="0,1,0,0" BorderBrush="#3d3d3d">
            <StackPanel>
                <!-- Header bar: always visible, click to toggle -->
                <DockPanel Height="26" Background="#252526">
                    <!-- Action buttons on the right -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                        <Button Content="📋"
                                Command="{Binding BottomPanel.ErrorConsole.CopyAllCommand}"
                                Width="28" Height="20" Margin="2,0" Padding="0"
                                Background="#3d3d3d" Foreground="LightGray"
                                FontSize="11"
                                ToolTip.Tip="{loc:Localize ErrorConsole.CopyAllTip}"/>
                        <Button Content="✕"
                                Command="{Binding BottomPanel.ErrorConsole.ClearCommand}"
                                Width="24" Height="20" Margin="2,0" Padding="0"
                                Background="#3d3d3d" Foreground="LightGray"
                                FontSize="11"
                                ToolTip.Tip="{loc:Localize ErrorConsole.ClearTip}"/>
                    </StackPanel>
                    <!-- Toggle button fills remaining space -->
                    <Button Command="{Binding BottomPanel.ErrorConsole.ToggleCommand}"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Height="26" Padding="8,0"
                            ToolTip.Tip="{loc:Localize ErrorConsole.ToggleTip}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="▶" Foreground="Gray" FontSize="9" VerticalAlignment="Center"
                                       IsVisible="{Binding BottomPanel.ErrorConsole.IsVisible, Converter={x:Static BoolConverters.Not}}"/>
                            <TextBlock Text="▼" Foreground="Gray" FontSize="9" VerticalAlignment="Center"
                                       IsVisible="{Binding BottomPanel.ErrorConsole.IsVisible}"/>
                            <TextBlock Text="{loc:Localize ErrorConsole.Title}" Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                            <!-- Error badge -->
                            <Border Background="#5d2020" CornerRadius="8" Padding="5,1"
                                    IsVisible="{Binding BottomPanel.ErrorConsole.HasErrors}">
                                <TextBlock Text="{Binding BottomPanel.ErrorConsole.ErrorCount}"
                                           Foreground="#FF6B6B" FontSize="10" VerticalAlignment="Center"/>
                            </Border>
                            <!-- Warning badge -->
                            <Border Background="#5d4510" CornerRadius="8" Padding="5,1"
                                    IsVisible="{Binding BottomPanel.ErrorConsole.HasWarnings}">
                                <TextBlock Text="{Binding BottomPanel.ErrorConsole.WarningCount}"
                                           Foreground="#FFD93D" FontSize="10" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </DockPanel>

                <!-- Content area: only shown when IsVisible is true -->
                <Border IsVisible="{Binding BottomPanel.ErrorConsole.IsVisible}" Height="180" Background="#161616">
                    <ListBox x:Name="ErrorConsoleListBox"
                             ItemsSource="{Binding BottomPanel.ErrorConsole.DisplayEntries}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="diagnostics:LogDisplayEntry">
                                <TextBlock Text="{Binding Text}"
                                           Foreground="{Binding Color}"
                                           FontFamily="Consolas, Courier New, monospace"
                                           FontSize="11"
                                           Padding="4,1"
                                           TextWrapping="NoWrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </StackPanel>
        </Border>

        <!-- Analysis Dock Panel (collapsible, above the Error Console, #570/#535) -->
        <panels:AnalysisDockPanel DockPanel.Dock="Bottom"/>

        <!-- Left Panel - Hierarchy + Component Library -->
        <Grid DockPanel.Dock="Left" ColumnDefinitions="*,Auto" Name="LeftPanelGrid">
            <Border Grid.Column="0"
                    Name="LeftPanelBorder"
                    MinWidth="200" MaxWidth="800"
                    Background="#252526">
                <Grid>
                    <!-- All content rows are star-sized so the splitters only redistribute a
                         FIXED total (the panel height): dragging one grows a neighbour's share
                         and shrinks the other, but nothing can ever be pushed past the window
                         edge. (Mixing px + star let the px Hierarchy row grow unbounded once its
                         px neighbour hit its minimum.) The star weights set the initial split. -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="240*" MinHeight="60"/>  <!-- Hierarchy -->
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="160*" MinHeight="34"/>  <!-- Saved Groups -->
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="320*" MinHeight="80"/>  <!-- Component Library -->
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="150*" MinHeight="34"/>  <!-- PDK Management -->
                    </Grid.RowDefinitions>
                <!-- Hierarchy Panel -->
                <views:HierarchyPanel Grid.Row="0"
                                      DataContext="{Binding LeftPanel.HierarchyPanel}"/>

                <!-- Splitter: Hierarchy / Saved Groups -->
                <GridSplitter Grid.Row="1"
                              Background="#3d3d3d"
                              ResizeDirection="Rows"
                              HorizontalAlignment="Stretch"/>

                <!-- Saved Groups rubric (own resizable section, like Hierarchy) -->
                <DockPanel Grid.Row="2">
                    <TextBlock DockPanel.Dock="Top" Text="{loc:Localize LeftPanel.SavedGroups}"
                               FontWeight="Bold" Margin="10,6,10,4" Foreground="White"
                               ToolTip.Tip="{loc:Localize LeftPanel.SavedGroupsTip}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="5,1">
                            <!-- Only shown when empty; the list (and the PDK Macros label) carry the rest -->
                            <TextBlock Text="{Binding LeftPanel.ComponentLibrary.StatusText}"
                                       FontSize="10" Foreground="Gray" Margin="0,0,0,2"
                                       IsVisible="{Binding LeftPanel.ComponentLibrary.StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                            <!-- User Groups (no label: this is the default/first list) -->
                            <ListBox x:Name="UserGroupsListBox"
                                     Classes="compactList"
                                     ItemsSource="{Binding LeftPanel.ComponentLibrary.UserGroups}"
                                     SelectionChanged="OnUserGroupsSelectionChanged"
                                     Background="Transparent"
                                     MaxHeight="150">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vmLib:GroupTemplateItemViewModel">
                                        <Border Margin="0,1" Cursor="Hand"
                                                ToolTip.Tip="{Binding Template.Description}"
                                                PointerEntered="OnGroupItemPointerEntered"
                                                PointerExited="OnGroupItemPointerExited"
                                                Background="Transparent"
                                                ClipToBounds="False">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{loc:Localize Common.Rename}" Command="{Binding RenameCommand}"/>
                                                    <MenuItem Header="{loc:Localize Common.Delete}" Command="{Binding DeleteCommand}"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <!-- Preview box with component count and size info -->
                                                <Border Width="40" Height="26"
                                                        Background="#1e1e1e"
                                                        BorderBrush="#3e3e3e"
                                                        BorderThickness="1"
                                                        CornerRadius="3"
                                                        Margin="0,0,5,0">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Template.ComponentCount}"
                                                                   FontSize="12" FontWeight="Bold"
                                                                   Foreground="#4CAF50"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{loc:Localize LeftPanel.CompAbbrev}" FontSize="7"
                                                                   Foreground="Gray"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,-2,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Template.Name}" FontWeight="SemiBold" FontSize="11" Foreground="White"/>
                                                    <TextBlock FontSize="9" Foreground="Gray">
                                                        <Run Text="{Binding Template.WidthMicrometers, StringFormat={}{0:F0}}"/>
                                                        <Run Text="×"/>
                                                        <Run Text="{Binding Template.HeightMicrometers, StringFormat={}{0:F0}}"/>
                                                        <Run Text="μm"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Delete button (visible on hover) -->
                                            <Button IsVisible="{Binding IsHovered}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Width="18" Height="18"
                                                    Padding="0"
                                                    Margin="0,-6,-6,0"
                                                    Background="#D32F2F"
                                                    CornerRadius="9"
                                                    Command="{Binding DeleteCommand}"
                                                    ToolTip.Tip="{loc:Localize LeftPanel.DeleteSavedGroupTip}">
                                                <PathIcon Data="M 4,4 L 10,10 M 4,10 L 10,4"
                                                          Width="10" Height="10"
                                                          Foreground="White"/>
                                            </Button>
                                        </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- PDK Groups -->
                            <TextBlock Text="{loc:Localize LeftPanel.PdkMacros}" Foreground="Orange" FontWeight="SemiBold"
                                       FontSize="10" Margin="0,5,0,2"
                                       IsVisible="{Binding LeftPanel.ComponentLibrary.PdkGroups.Count}"/>
                            <ListBox x:Name="PdkGroupsListBox"
                                     Classes="compactList"
                                     ItemsSource="{Binding LeftPanel.ComponentLibrary.PdkGroups}"
                                     SelectionChanged="OnPdkGroupsSelectionChanged"
                                     Background="Transparent"
                                     MaxHeight="150">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vmLib:GroupTemplateItemViewModel">
                                        <Border Margin="0,1" Cursor="Hand"
                                                ToolTip.Tip="{Binding Template.Description}"
                                                PointerEntered="OnGroupItemPointerEntered"
                                                PointerExited="OnGroupItemPointerExited"
                                                Background="Transparent"
                                                ClipToBounds="False">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{loc:Localize Common.Rename}" Command="{Binding RenameCommand}"/>
                                                    <MenuItem Header="{loc:Localize Common.Delete}" Command="{Binding DeleteCommand}"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <!-- Preview box with component count and size info -->
                                                <Border Width="40" Height="26"
                                                        Background="#1e1e1e"
                                                        BorderBrush="#3e3e3e"
                                                        BorderThickness="1"
                                                        CornerRadius="3"
                                                        Margin="0,0,5,0">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Template.ComponentCount}"
                                                                   FontSize="12" FontWeight="Bold"
                                                                   Foreground="#4CAF50"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{loc:Localize LeftPanel.CompAbbrev}" FontSize="7"
                                                                   Foreground="Gray"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,-2,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Template.Name}" FontWeight="SemiBold" FontSize="11" Foreground="White"/>
                                                    <TextBlock FontSize="9" Foreground="Gray">
                                                        <Run Text="{Binding Template.WidthMicrometers, StringFormat={}{0:F0}}"/>
                                                        <Run Text="×"/>
                                                        <Run Text="{Binding Template.HeightMicrometers, StringFormat={}{0:F0}}"/>
                                                        <Run Text="μm"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Delete button (visible on hover) -->
                                            <Button IsVisible="{Binding IsHovered}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Width="18" Height="18"
                                                    Padding="0"
                                                    Margin="0,-6,-6,0"
                                                    Background="#D32F2F"
                                                    CornerRadius="9"
                                                    Command="{Binding DeleteCommand}"
                                                    ToolTip.Tip="{loc:Localize LeftPanel.DeleteSavedGroupTip}">
                                                <PathIcon Data="M 4,4 L 10,10 M 4,10 L 10,4"
                                                          Width="10" Height="10"
                                                          Foreground="White"/>
                                            </Button>
                                        </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- Splitter: Saved Groups / Component Library -->
                <GridSplitter Grid.Row="3"
                              Background="#3d3d3d"
                              ResizeDirection="Rows"
                              HorizontalAlignment="Stretch"/>

                <!-- Component Library -->
                <DockPanel Grid.Row="4">
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="10,6,10,4">
                        <TextBlock Grid.Column="0" Text="{loc:Localize LeftPanel.ComponentLibrary}"
                                   FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <!-- Opens the Component Registry browser window (#656) — the online,
                             community-shared counterpart to this local library. -->
                        <Button Grid.Column="1" Content="🌐" Click="OpenRegistryBrowser_Click"
                                Padding="6,0" Margin="0,0,4,0" Background="#2a3a4a"
                                ToolTip.Tip="{loc:Localize Registry.OpenTip}"/>
                        <Button Grid.Column="2" Content="+" Command="{Binding LeftPanel.OpenNewComponentCommand}"
                                Padding="8,0" FontWeight="Bold" Background="#2a4a2a"
                                ToolTip.Tip="{loc:Localize LeftPanel.NewComponentTip}"/>
                    </Grid>
                    <TextBox DockPanel.Dock="Top" Watermark="{loc:Localize LeftPanel.SearchWatermark}"
                             Text="{Binding LeftPanel.SearchText}"
                             Margin="10,0,10,6" FontSize="11"
                             Background="#1e1e1e" Foreground="White"
                             BorderBrush="#3e3e3e"/>
                    <TextBlock DockPanel.Dock="Top" Text="{loc:Localize LeftPanel.PlaceHint}"
                               FontSize="10" Margin="10,0,10,5" Foreground="Gray" TextWrapping="Wrap"/>

                    <ScrollViewer x:Name="ComponentLibraryScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  behaviors:ScrollPositionBehavior.VerticalOffset="{Binding LeftPanel.LibraryScrollOffset, Mode=TwoWay}">
                        <ListBox ItemsSource="{Binding LeftPanel.FilteredTemplates}"
                                 Classes="compactList"
                                 SelectedItem="{Binding CanvasInteraction.SelectedTemplate}"
                                 Background="Transparent" Foreground="White"
                                 Margin="5,0"
                                 controls:ComponentPreview.RenderService="{Binding GdsPreviewRenderService}">
                            <ListBox.Styles>
                                <!-- Inline edit/delete icons on a custom component appear only on
                                     hover or when the row is selected — keeps the palette clean
                                     but discoverable (no hidden-only context menu). -->
                                <!-- Default hidden via STYLE (not an inline Opacity, which would
                                     out-prioritise the hover setter and stay invisible). -->
                                <Style Selector="ListBoxItem StackPanel.itemActions">
                                    <Setter Property="Opacity" Value="0"/>
                                </Style>
                                <Style Selector="ListBoxItem:pointerover StackPanel.itemActions">
                                    <Setter Property="Opacity" Value="1"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected StackPanel.itemActions">
                                    <Setter Property="Opacity" Value="1"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vmLib:ComponentTemplate">
                                    <DockPanel Margin="0,1" HorizontalAlignment="Stretch">
                                        <!-- Right margin keeps the hover icons off the row's right
                                             edge (mirrors the preview's 6px gap on the left). -->
                                        <StackPanel Classes="itemActions" DockPanel.Dock="Right" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="0,0,6,0">
                                            <Button Content="✏" Click="TemplateEditComponent_Click"
                                                    FontSize="11" Padding="4,0" MinWidth="0"
                                                    Background="Transparent" BorderThickness="0" Foreground="#c9c9c9"
                                                    ToolTip.Tip="{loc:Localize LeftPanel.EditComponentTip}"/>
                                            <!-- ✕ only where there is something to delete or restore:
                                                 IsDeletable is false for bundled components AND for fork
                                                 components identical to their bundled original. -->
                                            <Button Content="✕" Click="TemplateDeleteComponent_Click"
                                                    IsVisible="{Binding IsDeletable}"
                                                    FontSize="11" Padding="4,0" MinWidth="0" Margin="2,0,0,0"
                                                    Background="Transparent" BorderThickness="0" Foreground="#e08a8a"
                                                    ToolTip.Tip="{loc:Localize LeftPanel.DeleteComponentTip}"/>
                                        </StackPanel>
                                        <controls:ComponentPreview DockPanel.Dock="Left"
                                            Width="56" Height="36"
                                            WidthMicrometers="{Binding WidthMicrometers}"
                                            HeightMicrometers="{Binding HeightMicrometers}"
                                            PinDefinitions="{Binding PinDefinitions}"
                                            NazcaModuleName="{Binding NazcaModuleName}"
                                            NazcaFunctionName="{Binding NazcaFunctionName}"
                                            GdsFactoryFunction="{Binding GdsFactoryFunction}"
                                            Margin="0,0,6,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11"/>
                                                <!-- User-global S-matrix override badge: signals that this template's
                                                     S-matrix has been replaced by an imported override that applies
                                                     to every project the user opens. -->
                                                <TextBlock Text="📊"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Margin="4,0,0,0"
                                                           IsVisible="{Binding HasUserGlobalSMatrixOverride}"
                                                           ToolTip.Tip="{loc:Localize LeftPanel.SMatrixOverrideTip}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Category}" FontSize="9" Foreground="Gray"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </DockPanel>

                <!-- Splitter: Component Library / PDK Management -->
                <GridSplitter Grid.Row="5"
                              Background="#3d3d3d"
                              ResizeDirection="Rows"
                              HorizontalAlignment="Stretch"/>

                <!-- PDK Management rubric (own resizable section, like Hierarchy) -->
                <DockPanel Grid.Row="6">
                    <DockPanel DockPanel.Dock="Top" Margin="10,6,10,4">
                        <!-- Opens CreateCustomPdkWindow directly, no "New Component" detour
                             (issue #700 follow-up, LC-T2) -->
                        <Button DockPanel.Dock="Right" Content="+" Click="PdkCreate_Click"
                                Width="22" Height="22" Padding="0" FontSize="14" FontWeight="Bold"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="#3d3d3d" Foreground="White"
                                ToolTip.Tip="{loc:Localize LeftPanel.CreatePdkTip}"/>
                        <!-- Small trash button: recover deleted PDKs / removed components from
                             user-pdks/.trash (PDK-lifecycle follow-up). Opens a compact flyout. -->
                        <Button DockPanel.Dock="Right" Content="🗑" Command="{Binding LeftPanel.PdkTrash.OpenCommand}"
                                Width="22" Height="22" Padding="0" FontSize="12" Margin="0,0,4,0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="#3d3d3d" Foreground="#c9c9c9"
                                ToolTip.Tip="{loc:Localize LeftPanel.TrashTip}">
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <panels:PdkTrashPanel DataContext="{Binding LeftPanel.PdkTrash}"/>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <!-- DockPanel places each subsequent Dock="Right" child further left, so
                             the visual order is: Title, EnableAll, DisableAll, Trash, "+". -->
                        <Button DockPanel.Dock="Right" Content="☐" Command="{Binding LeftPanel.PdkManager.DisableAllCommand}"
                                Width="22" Height="22" Padding="0" FontSize="12" Margin="0,0,4,0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="#3d3d3d" Foreground="#c9c9c9"
                                ToolTip.Tip="{loc:Localize LeftPanel.DisableAllPdksTip}"/>
                        <Button DockPanel.Dock="Right" Content="☑" Command="{Binding LeftPanel.PdkManager.EnableAllCommand}"
                                Width="22" Height="22" Padding="0" FontSize="12" Margin="0,0,4,0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="#3d3d3d" Foreground="#c9c9c9"
                                ToolTip.Tip="{loc:Localize LeftPanel.EnableAllPdksTip}"/>
                        <TextBlock Text="{loc:Localize LeftPanel.PdkMgmt}" VerticalAlignment="Center"
                                   FontWeight="Bold" Foreground="White"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="5">
                            <TextBlock Text="{Binding LeftPanel.PdkManager.StatusText}"
                                       FontSize="10" Foreground="LightGray" Margin="0,0,0,5"/>

                            <!-- PDK Filter List -->
                            <ItemsControl ItemsSource="{Binding LeftPanel.PdkManager.LoadedPdks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vmLib:PdkInfoViewModel">
                                        <StackPanel Margin="0,3">
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding IsEnabled}"
                                                          Content="{Binding Name}"
                                                          FontSize="10"
                                                          Margin="0,0,5,0"
                                                          IsEnabled="{Binding !IsLockedByProcess}"/>
                                                <TextBlock Text="🔒" FontSize="9" VerticalAlignment="Center"
                                                           IsVisible="{Binding IsLockedByProcess}"
                                                           ToolTip.Tip="{loc:Localize LeftPanel.PdkLockedTip}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                                                <TextBlock Text="{Binding SourceBadge}"
                                                           FontSize="9" Foreground="Gray" Margin="0,0,5,0"/>
                                                <TextBlock FontSize="9" Foreground="Gray" Margin="0,0,5,0">
                                                    <Run Text="{Binding ComponentCount}"/><Run Text=" "/><Run Text="{loc:Localize LeftPanel.ComponentsSuffix}"/>
                                                </TextBlock>
                                                <!-- Edits this PDK's own fabrication process (layer
                                                     stack, cross-sections, materials). Bundled PDKs stay
                                                     read-only: saving there implicitly writes a custom
                                                     fork copy instead of touching the bundled file. -->
                                                <Button Content="✏"
                                                        Click="PdkEditProcess_Click"
                                                        FontSize="11" Padding="5,1" MinWidth="0" Background="#3d3d3d" Foreground="#c9c9c9"
                                                        ToolTip.Tip="{loc:Localize LeftPanel.EditPdkTip}"/>
                                                <!-- Moves this custom PDK's file to user-pdks/.trash after a
                                                     confirm prompt (LC-T5). Bundled PDKs are read-only and have
                                                     no Delete button. -->
                                                <Button Content="✕" IsVisible="{Binding !IsBundled}"
                                                        Click="PdkDelete_Click"
                                                        FontSize="11" Padding="5,1" MinWidth="0" Background="#3d3d3d" Foreground="#e08a8a" Margin="4,0,0,0"
                                                        ToolTip.Tip="{loc:Localize LeftPanel.DeletePdkTip}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
                </Grid>
            </Border>

            <!-- GridSplitter for resizing left panel -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          Background="#3d3d3d"
                          ResizeDirection="Columns"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"/>
        </Grid>

        <!-- Right Panel - Properties -->
        <Grid DockPanel.Dock="Right" ColumnDefinitions="Auto,*" Name="RightPanelGrid">
            <!-- GridSplitter for resizing right panel -->
            <GridSplitter Grid.Column="0"
                          Width="4"
                          Background="#3d3d3d"
                          ResizeDirection="Columns"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"/>

            <Border Grid.Column="1"
                    Name="RightPanelBorder"
                    MinWidth="200" MaxWidth="800"
                    Background="#252526">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{loc:Localize RightPanel.Properties}"
                           FontWeight="Bold" Margin="10" Foreground="White"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="10">
                    <!-- Selection-driven properties: name, position, size and the
                         per-component editors (ONA Analyzer sweep button, sliders,
                         light-source config…) all live in this single panel. -->
                    <panels:SelectedComponentPropertiesPanel/>

                    <!-- Parameter Sweep (visible when component has slider) -->
                    <StackPanel IsVisible="{Binding CanvasInteraction.SelectedComponent.HasSliders, FallbackValue=False}">
                        <Separator Margin="0,20,0,10" Background="#3d3d3d"/>
                        <TextBlock Text="{loc:Localize Sweep.Title}" Foreground="Orange" Margin="0,0,0,5" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                            <TextBlock Text="{loc:Localize Sweep.Start}" Foreground="Gray" VerticalAlignment="Center" Width="45"/>
                            <NumericUpDown Value="{Binding RightPanel.Sweep.StartValue}"
                                           Minimum="{Binding CanvasInteraction.SelectedComponent.SliderMin}"
                                           Maximum="{Binding CanvasInteraction.SelectedComponent.SliderMax}"
                                           Increment="10" Width="130" FormatString="F0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="{loc:Localize Sweep.End}" Foreground="Gray" VerticalAlignment="Center" Width="45"/>
                            <NumericUpDown Value="{Binding RightPanel.Sweep.EndValue}"
                                           Minimum="{Binding CanvasInteraction.SelectedComponent.SliderMin}"
                                           Maximum="{Binding CanvasInteraction.SelectedComponent.SliderMax}"
                                           Increment="10" Width="130" FormatString="F0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="{loc:Localize Sweep.Steps}" Foreground="Gray" VerticalAlignment="Center" Width="45"/>
                            <NumericUpDown Value="{Binding RightPanel.Sweep.StepCount}"
                                           Minimum="2" Maximum="100"
                                           Increment="1" Width="130" FormatString="F0"/>
                        </StackPanel>
                        <Button Content="{loc:Localize Sweep.Run}" Command="{Binding RightPanel.Sweep.RunSweepCommand}"
                                Width="120" Margin="0,5,0,5" Background="#3d5d3d"
                                IsEnabled="{Binding RightPanel.Sweep.IsSweeping, Converter={x:Static BoolConverters.Not}}"/>
                        <TextBlock Text="{Binding RightPanel.Sweep.StatusText}" Foreground="Gray" FontSize="10" Margin="0,0,0,5"
                                   IsVisible="{Binding RightPanel.Sweep.StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <ScrollViewer MaxHeight="200" Margin="0,5,0,0"
                                      IsVisible="{Binding RightPanel.Sweep.ResultText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding RightPanel.Sweep.ResultText}" Foreground="LightGreen"
                                       FontFamily="Consolas" FontSize="10" TextWrapping="NoWrap"/>
                        </ScrollViewer>
                        <Button Content="{loc:Localize Sweep.ExportCsv}" Command="{Binding RightPanel.Sweep.ExportCsvCommand}"
                                Width="100" Margin="0,5,0,0" Background="#3d3d5d"
                                IsVisible="{Binding RightPanel.Sweep.ResultText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>

                    <!-- Connection Routing (style, width/radius, freeze, per-bend radius — issue #574) -->
                    <panels:ConnectionRoutingPanel/>

                    <!-- AI Design Assistant Panel -->
                    <panels:AiAssistantPanel/>

                    <!-- Design Checks Panel -->
                    <panels:DesignChecksPanel/>

                    <!-- Netlist Panel (gdsfactory YAML view/export, #687) -->
                    <panels:NetlistPanel/>

                </StackPanel>
                </ScrollViewer>
            </DockPanel>
            </Border>
        </Grid>

        <!-- Main Canvas with Edit Mode Banner -->
        <DockPanel>
            <!-- Update Banner -->
            <Border DockPanel.Dock="Top"
                    Background="#21463A"
                    IsVisible="{Binding Update.UpdateAvailable}"
                    Padding="14,10"
                    BorderBrush="#3F8F73"
                    BorderThickness="0,0,0,2">
                <Grid ColumnDefinitions="*,Auto"
                      RowDefinitions="Auto,Auto,Auto">
                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                        <TextBlock Text="{Binding Update.LatestVersionText}"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="14"/>
                        <TextBlock Text="{Binding Update.StatusText}"
                                   Foreground="#D4F2E6"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding Update.StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Right">
                        <Button Content="{loc:Localize Update.SkipVersion}"
                                Command="{Binding Update.SkipThisVersionCommand}"
                                Background="#6A4A32"
                                Foreground="White"
                                Padding="14,6"
                                IsEnabled="{Binding Update.IsDownloading, Converter={x:Static BoolConverters.Not}}"/>
                        <Button Content="{loc:Localize Update.Skip}"
                                Command="{Binding Update.RemindLaterCommand}"
                                Background="#355248"
                                Foreground="White"
                                Padding="14,6"
                                IsEnabled="{Binding Update.IsDownloading, Converter={x:Static BoolConverters.Not}}"/>
                        <Button Content="{loc:Localize Update.Download}"
                                Command="{Binding Update.InstallUpdateCommand}"
                                Background="#8FD3A7"
                                Foreground="#163227"
                                FontWeight="SemiBold"
                                Padding="16,6"
                                IsEnabled="{Binding Update.IsDownloading, Converter={x:Static BoolConverters.Not}}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                               Margin="0,8,0,0"
                               Text="{Binding Update.ReleaseNotes}"
                               Foreground="#C5E8DB"
                               FontSize="11"
                               TextWrapping="Wrap"
                               MaxHeight="72"
                               IsVisible="{Binding Update.ReleaseNotes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <ProgressBar Grid.Row="2" Grid.ColumnSpan="2"
                                 Margin="0,10,0,0"
                                 Value="{Binding Update.DownloadProgress}"
                                 Minimum="0"
                                 Maximum="1"
                                 Height="6"
                                 IsVisible="{Binding Update.IsDownloading}"/>
                </Grid>
            </Border>

            <!-- Edit Mode Banner (only visible when in edit mode) -->
            <Border DockPanel.Dock="Top"
                    Background="#FF6B35"
                    IsVisible="{Binding Canvas.IsInGroupEditMode}"
                    Padding="12,8"
                    BorderBrush="#FF4520"
                    BorderThickness="0,0,0,2">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Icon and Label -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="✏️" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Localize EditMode.Title}" FontWeight="Bold" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="—" Foreground="#FFB399" Margin="5,0" VerticalAlignment="Center"/>
                        <TextBlock Foreground="White" FontSize="12" VerticalAlignment="Center">
                            <Run Text="{loc:Localize EditMode.Editing}"/>
                            <Run Text="{Binding Canvas.CurrentEditGroup.GroupName}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Exit Button -->
                    <Button Grid.Column="2"
                            Content="{loc:Localize EditMode.ExitButton}"
                            Command="{Binding Canvas.ExitToRootCommand}"
                            Background="White"
                            Foreground="#FF6B35"
                            FontWeight="SemiBold"
                            Padding="16,6"
                            BorderThickness="0"
                            CornerRadius="3"
                            Cursor="Hand"
                            ToolTip.Tip="{loc:Localize EditMode.ExitTip}"/>
                </Grid>
            </Border>

            <!-- Design Canvas with floating mode-probe flyout overlay (issue #691) -->
            <Panel>
            <controls:DesignCanvas x:Name="DesignCanvasControl"
                                   ViewModel="{Binding Canvas}"
                                   Zoom="{Binding ViewportControl.ZoomLevel, Mode=TwoWay}"
                                   MainViewModel="{Binding}">
                <controls:DesignCanvas.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{loc:Localize Context.EditComponent}" Command="{Binding CanvasInteraction.OpenSelectedComponentSettingsCommand}">
                        <MenuItem.Icon>
                            <TextBlock Text="⚙️" FontSize="14"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="{loc:Localize Context.Copy}" Command="{Binding CopySelectedCommand}" InputGesture="Ctrl+C">
                        <MenuItem.Icon>
                            <TextBlock Text="📋" FontSize="14"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{loc:Localize Context.Paste}" Command="{Binding PasteSelectedCommand}" InputGesture="Ctrl+V">
                        <MenuItem.Icon>
                            <TextBlock Text="📄" FontSize="14"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="{loc:Localize Context.CreateGroup}" Command="{Binding CreateGroupCommand}" InputGesture="Ctrl+G">
                        <MenuItem.Icon>
                            <PathIcon Data="M4,4 L12,4 L12,12 L4,12 Z M6,6 L10,6 L10,10 L6,10 Z"
                                      Width="16" Height="16" Foreground="LightBlue"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{loc:Localize Context.Ungroup}" Command="{Binding UngroupCommand}" InputGesture="Ctrl+Shift+G">
                        <MenuItem.Icon>
                            <PathIcon Data="M4,4 L6,4 L6,6 L4,6 Z M10,4 L12,4 L12,6 L10,6 Z M4,10 L6,10 L6,12 L4,12 Z M10,10 L12,10 L12,12 L10,12 Z"
                                      Width="16" Height="16" Foreground="Orange"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{loc:Localize Context.RenameGroup}" Command="{Binding CanvasInteraction.RenameGroupCommand}">
                        <MenuItem.Icon>
                            <TextBlock Text="✏️" FontSize="14"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{loc:Localize Context.SaveAsPrefab}" Command="{Binding CanvasInteraction.SaveGroupAsCommand}">
                        <MenuItem.Icon>
                            <TextBlock Text="💾" FontSize="14"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="{loc:Localize Common.Delete}" Command="{Binding DeleteSelectedCommand}" InputGesture="Delete">
                        <MenuItem.Icon>
                            <TextBlock Text="🗑️" FontSize="14"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </controls:DesignCanvas.ContextMenu>
            </controls:DesignCanvas>

            <!-- Mode-probe flyout: non-modal, anchored at the probe click point.
                 The overlay Canvas has no background, so canvas interaction stays live. -->
            <Canvas IsVisible="{Binding ModeProbe.IsOpen, FallbackValue=False}">
                <panels:ModeProbePanel DataContext="{Binding ModeProbe}"
                                       Canvas.Left="{Binding PanelX}"
                                       Canvas.Top="{Binding PanelY}"/>
            </Canvas>
            </Panel>
        </DockPanel>
    </DockPanel>

    <!-- Home screen overlay: compact centered card over the dimmed editor,
         shown until a project is opened/created; reopenable via the Home button -->
    <Border IsVisible="{Binding Home.IsHomeVisible}" Background="#B3141414">
        <views:HomeView DataContext="{Binding Home}"/>
    </Border>
    </Grid>
</Window>
