<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vmp="using:CAP.Avalonia.ViewModels.Process"
        x:Class="CAP.Avalonia.Views.ProcessSelectionDialog"
        x:Name="DialogRoot"
        x:DataType="vmp:ProcessSelectionViewModel"
        x:CompileBindings="True"
        Title="Choose fabrication process"
        Width="460" Height="420"
        MinWidth="360" MinHeight="300"
        Background="#1e1e1e"
        Foreground="White"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="16">

        <!-- Heading -->
        <TextBlock DockPanel.Dock="Top"
                   Text="Choose fabrication process"
                   FontWeight="SemiBold"
                   FontSize="15"
                   Foreground="LightBlue"
                   Margin="0,0,0,4"/>

        <!-- Explanation -->
        <TextBlock DockPanel.Dock="Top"
                   Text="A design is locked to one fabrication process — components from incompatible PDKs can't be mixed on the same chip. Choose Playground to prototype freely with any component (not manufacturable)."
                   Foreground="#bbbbbb"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <!-- Buttons -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0"
                    Spacing="8">
            <Button Content="Cancel"
                    Click="OnCancelClick"
                    IsCancel="True"
                    Width="80"
                    Background="#3d3d3d"
                    Foreground="White"/>
            <Button Content="Start design"
                    Click="OnStartDesignClick"
                    IsEnabled="{Binding CanConfirm}"
                    Width="110"
                    Background="#0d6efd"
                    Foreground="White"
                    IsDefault="True"/>
        </StackPanel>

        <!-- Process choices: one entry per derived process group, plus a trailing
             Playground option (issue #570). The Playground item is visually marked
             with a warning glyph since it produces a non-manufacturable design. -->
        <ListBox ItemsSource="{Binding Choices}"
                 SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                 Background="Transparent"
                 BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vmp:ProcessChoiceItem">
                    <Border Background="#252526"
                            CornerRadius="4"
                            Padding="10,8"
                            Margin="0,2">
                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="⚠"
                                           Foreground="#FFA500"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding IsPlayground}"/>
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           FontSize="13"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Subtitle}"
                                       Foreground="Gray"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</Window>
